{
    "flow": {
        "name": "invoice entities extraction flow (expanded)",
        "flow_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
        "description": "a flow to extract structured invoice entities using Ollama LLM with expand_extracted_data, then chunk and store in OpenSearch with individual entity columns",
        "storage": "in-memory",
        "execute_type": "local",
        "global_config": {
            "doc_column": "content",
            "disable_validation": "true",
            "force_ingest": true
        },
        "dag": [
            {
                "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
                "name": "ingest",
                "operator": "ingest_local",
                "config": {
                    "input_folder": "tests/fixtures/invoices",
                    "include_filter": ".pdf",
                    "store_binary_content": "true",
                    "max_workers": 2
                },
                "input_edges": [],
                "output_edges": [{"node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"}]
            },
            {
                "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
                "name": "extract",
                "operator": "extract",
                "config": {
                    "extraction_type": "text",
                    "doc_column": "content",
                    "text_provider": {
                        "name": "docling",
                        "params": {}
                    }
                },
                "input_edges": [{"node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"}],
                "output_edges": [{"node_id_ref": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80"}]
            },
            {
                "id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80",
                "name": "extract_entities",
                "operator": "extract",
                "config": {
                    "extraction_type": "entity",
                    "doc_column": "content",
                    "entity_provider": {
                        "name": "ollama",
                        "params": {
                            "model_name": "granite4",
                            "max_doc_chars": 8000,
                            "temperature": 0.0,
                            "expand_extracted_data": true,
                            "schema": {
                                "columns": {
                                    "vendor_name": "STRING",
                                    "invoice_date": "STRING",
                                    "invoice_number": "STRING",
                                    "total_amount": "DOUBLE",
                                    "grand_total": "DOUBLE"
                                }
                            }
                        }
                    }
                },
                "input_edges": [{"node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"}],
                "output_edges": [{"node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"}]
            },
            {
                "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
                "name": "chunk",
                "operator": "chunker",
                "config": {
                    "chunk_type": "hybrid",
                    "doc_column": "content",
                    "chunk_size": 512,
                    "chunk_overlap": 128,
                    "retain_original_content": "true"
                },
                "input_edges": [{"node_id_ref": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80"}],
                "output_edges": [{"node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"}]
            },
            {
                "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
                "name": "embeddings",
                "operator": "embeddings",
                "config": {
                    "embeddings_type": "ollama",
                    "embeddings_model_id": "granite4",
                    "embeddings_column": "embeddings",
                    "overlap_ratio": 0.2,
                    "doc_column": "content"
                },
                "input_edges": [{"node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"}],
                "output_edges": [{"node_id_ref": "87249dbf-4a1a-433a-91da-ee5fb3244284"}]
            },
            {
                "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
                "name": "vectordb",
                "operator": "opensearch",
                "config": {
                    "opensearch_host": "localhost",
                    "opensearch_port": 9200,
                    "opensearch_username": "admin",
                    "opensearch_password": "MyStrongPass123!",
                    "opensearch_use_ssl": false,
                    "opensearch_verify_certs": false,
                    "index_name": "invoices_entities_expanded_test",
                    "doc_id_column": "doc_id_hash",
                    "embeddings_column": "embeddings",
                    "vector_dimension": 2560,
                    "engine": "faiss",
                    "algorithm": "hnsw",
                    "space_type": "l2",
                    "batch_size": 100,
                    "create_index": "true",
                    "available_features": {
                        "doc_id_hash": {
                            "name": "Document ID",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "string",
                            "is_primary": true
                        },
                        "content": {
                            "name": "Content",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "embeddings": {
                            "name": "Embeddings",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "vector"
                        },
                        "entities": {
                            "name": "Entities",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "entity_vendor_name": {
                            "name": "Vendor Name",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "entity_invoice_date": {
                            "name": "Invoice Date",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "entity_invoice_number": {
                            "name": "Invoice Number",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "entity_total_amount": {
                            "name": "Total Amount",
                            "available_for_vector_db": true,
                            "type": "float"
                        },
                        "entity_grand_total": {
                            "name": "Grand Total",
                            "available_for_vector_db": true,
                            "type": "float"
                        }
                    },
                    "feature_mappings": {
                        "doc_id_hash": "pk",
                        "content": "text",
                        "embeddings": "vector_embeddings",
                        "entities": "invoice_entities",
                        "entity_vendor_name": "entity_vendor_name",
                        "entity_invoice_date": "entity_invoice_date",
                        "entity_invoice_number": "entity_invoice_number",
                        "entity_total_amount": "entity_total_amount",
                        "entity_grand_total": "entity_grand_total"
                    }
                },
                "input_edges": [{"node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"}],
                "output_edges": []
            }
        ]
    }
}