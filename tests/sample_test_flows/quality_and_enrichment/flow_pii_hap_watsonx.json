{
  "flow_name": "PII and HAP Detection Flow - WatsonX.ai Provider",
  "description": "Flow to test PII and HAP detection using hexagonal architecture with WatsonX.ai provider",
  "global_config": {
    "doc_column": "content",
    "disable_validation": "true",
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "input_folder": "tests/fixtures/customer_support_docs/",
        "include_filter": "txt",
        "store_binary_content": false,
        "max_workers": 2
      }
    },
    {
      "name": "extract",
      "type": "extract_docling",
      "config": {
        "doc_column": "content"
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "pii_and_hap_detection_watsonx",
      "type": "pii_and_hap",
      "config": {
        "provider": "watsonx",
        "provider_config": {
          "api_key": "<your api key>",
          "url": "https://wxai-qa.ml.cloud.ibm.com",
          "container_kind": "project",
          "container_id": "<your project id>"
        },
        "pii_threshold": 0.5,
        "hap_threshold": 0.75,
        "expected_redactions": [
          "pii",
          "hap"
        ],
        "pii_list": [
          "EmailAddress",
          "PhoneNumber",
          "SocialSecurityNumber",
          "CreditCardNumber",
          "BankAccountNumber",
          "IPAddress"
        ],
        "redaction": true,
        "redaction_character": "*",
        "hap_redaction": true,
        "hap_redaction_character": "#",
        "display_pii": true,
        "batch_size": 4,
        "min_chunk_size_kb": 51200,
        "max_chunk_size_kb": 102400,
        "doc_column": "content"
      },
      "depends_on": [
        "extract"
      ]
    }
  ]
}
