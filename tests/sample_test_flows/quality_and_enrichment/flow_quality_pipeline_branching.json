{
  "flow": {
    "name": "Quality Pipeline with Branching",
    "flow_id": "7b71c0ef-2e7e-471c-8cef-4d7a27c1a851",
    "description": "Comprehensive quality operators showcase: Ingest → Extract → Language Detection → Dedup (removes 2 duplicate documents) → Readability → Branching (on flesch_ease) → [High Quality: ML Enrichment → Embeddings → OpenSearch] | [Low Quality: SQLFilter → Embeddings → OpenSearch]. Demonstrates Readability, Dedup, BranchingOperator, and SQLFilter operators with quality-based conditional routing.",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true",
      "force_ingest": true
    },
    "dag": [
      {
        "id": "133d6e65-9ef5-4a8b-9cb4-971e5bdbe03c",
        "name": "ingest",
        "operator": "ingest_local",
        "config": {
          "input_folder": "tests/fixtures/customer_support_docs/",
          "include_filter": "txt,pdf",
          "store_binary_content": true,
          "max_workers": 2
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "2f673122-d4f3-4fb1-bed5-b4fbff087753"
          }
        ]
      },
      {
        "id": "2f673122-d4f3-4fb1-bed5-b4fbff087753",
        "name": "extract",
        "operator": "extract_operator",
        "config": {
          "doc_column": "content",
          "text_extraction_mode": "docling_library",
          "entity_extraction_mode": "none"
        },
        "input_edges": [
          {
            "node_id_ref": "133d6e65-9ef5-4a8b-9cb4-971e5bdbe03c"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "88bff0c8-4cb6-4459-8346-6af43a30110c"
          }
        ]
      },
      {
        "id": "88bff0c8-4cb6-4459-8346-6af43a30110c",
        "name": "detect_language",
        "operator": "lang_detect",
        "config": {
          "doc_column": "content",
          "lang_column": "lang_name"
        },
        "input_edges": [
          {
            "node_id_ref": "2f673122-d4f3-4fb1-bed5-b4fbff087753"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "1aee4061-4feb-4d99-9d8b-4055746f692d"
          }
        ]
      },
      {
        "id": "1aee4061-4feb-4d99-9d8b-4055746f692d",
        "name": "dedup",
        "operator": "ededup",
        "config": {
          "doc_column": "content",
          "doc_id_column": "doc_id_hash"
        },
        "input_edges": [
          {
            "node_id_ref": "88bff0c8-4cb6-4459-8346-6af43a30110c"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "fe454610-2aaa-4af3-aa25-88f40abedbdd"
          }
        ]
      },
      {
        "id": "fe454610-2aaa-4af3-aa25-88f40abedbdd",
        "name": "readability",
        "operator": "readability",
        "config": {
          "doc_column": "content",
          "readability_score_list": [
            "flesch_ease",
            "flesch_kincaid",
            "gunning_fog",
            "difficult_words",
            "dale_chall_readability_score"
          ]
        },
        "input_edges": [
          {
            "node_id_ref": "1aee4061-4feb-4d99-9d8b-4055746f692d"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "1f63b885-1f0c-4d19-8386-569b1e554f96"
          }
        ]
      },
      {
        "id": "1f63b885-1f0c-4d19-8386-569b1e554f96",
        "name": "quality_branching",
        "operator": "branching",
        "config": {
          "branches": [
            {
              "link_id": "high_quality_branch",
              "link_name": "High Quality Documents",
              "filter_criteria_json": {
                "criteria_list": [
                  "flesch_ease_textstat > 60"
                ],
                "logical_operator": "AND"
              }
            },
            {
              "link_id": "low_quality_branch",
              "link_name": "Low Quality Documents",
              "filter_criteria_json": {
                "criteria_list": [
                  "flesch_ease_textstat <= 60"
                ],
                "logical_operator": "AND"
              }
            }
          ]
        },
        "input_edges": [
          {
            "node_id_ref": "fe454610-2aaa-4af3-aa25-88f40abedbdd"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "57e66cab-da6f-479f-8e21-416c9763fa45",
