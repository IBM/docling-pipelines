{
  "flow_name": "PII and HAP Detection Flow with Ollama",
  "description": "Flow to detect PII and HAP in documents using Ollama LLM",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "tests/fixtures/customer_support_docs/",
        "include_filter": "txt",
        "store_binary_content": false,
        "max_workers": 2
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "doc_column": "content",
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none"
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "pii_and_hap_detection",
      "type": "pii_and_hap",
      "config": {
        "provider": "ollama",
        "model_name": "llama3.2:3b",
        "pii_threshold": 0.5,
        "hap_threshold": 0.75,
        "expected_redactions": [
          "pii",
          "hap"
        ],
        "pii_list": [
          "EmailAddress",
          "PhoneNumber",
          "SocialSecurityNumber",
          "CreditCardNumber",
          "BankAccountNumber",
          "IPAddress"
        ],
        "redaction": true,
        "redaction_character": "*",
        "hap_redaction": true,
        "hap_redaction_character": "#",
        "display_pii": true,
        "max_workers": 4,
        "chunk_size": 50000,
        "doc_column": "content"
      },
      "depends_on": [
        "extract"
      ]
    }
  ]
}
