{
  "flow": {
    "name": "ML Enrichment with OpenSearch Pipeline",
    "flow_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567891",
    "description": "Complete pipeline: ingest \u2192 extract \u2192 language detection \u2192 ML enrichment \u2192 embeddings \u2192 OpenSearch indexing",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true",
      "force_ingest": true
    },
    "dag": [
      {
        "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
        "name": "ingest",
        "operator": "ingest_local",
        "config": {
          "input_folder": "src/datasift_opensource/ui/chat_with_docs/uploaded_files/",
          "include_filter": "txt,pdf",
          "store_binary_content": "true",
          "max_workers": 2
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ]
      },
      {
        "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
        "name": "extract",
        "operator": "extract_operator",
        "config": {
          "doc_column": "content",
          "text_extraction_mode": "docling_library",
          "entity_extraction_mode": "none"
        },
        "input_edges": [
          {
            "node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "8def9abc-c1d2-4e3f-9a0b-1c2d3e4f5a6b"
          }
        ]
      },
      {
        "id": "8def9abc-c1d2-4e3f-9a0b-1c2d3e4f5a6b",
        "name": "detect_language",
        "operator": "lang_detect_fasttext",
        "config": {
          "doc_column": "content",
          "lang_column": "lang_name"
        },
        "input_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "9ef0abcd-d2e3-4f5a-0b1c-2d3e4f5a6b7c"
          }
        ]
      },
      {
        "id": "9ef0abcd-d2e3-4f5a-0b1c-2d3e4f5a6b7c",
        "name": "ml_enrichment",
        "operator": "ml_enrichment",
        "config": {
          "doc_column": "content",
          "lang_column": "lang_name",
          "output_column_prefix": "ml_",
          "error_column_name": "enrichment_error"
        },
        "input_edges": [
          {
            "node_id_ref": "8def9abc-c1d2-4e3f-9a0b-1c2d3e4f5a6b"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"
          }
        ]
      },
      {
        "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
        "name": "embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "ollama",
          "embeddings_model_id": "granite4:latest",
          "embeddings_column": "embeddings",
          "overlap_ratio": 0.2,
          "doc_column": "content"
        },
        "input_edges": [
          {
            "node_id_ref": "9ef0abcd-d2e3-4f5a-0b1c-2d3e4f5a6b7c"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "87249dbf-4a1a-433a-91da-ee5fb3244284"
          }
        ]
      },
      {
        "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
        "name": "vectordb",
        "operator": "vectordb",
        "config": {
          "provider": "opensearch",
          "index_name": "ml_enriched_documents",
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "vector_dimension": 2560,
          "create_index": "true",
          "provider_config": {
            "host": "localhost",
            "port": 9200,
            "username": "admin",
            "password": "MyStrongPass123!",
            "use_ssl": false,
            "verify_certs": false,
            "batch_size": 100,
            "engine": "faiss",
            "algorithm": "hnsw",
            "space_type": "l2"
          },
          "available_features": {
            "doc_id_hash": {
              "name": "Document ID",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "name": {
              "name": "Document Name",
              "available_for_vector_db": true,
              "type": "string"
            },
            "content": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            },
            "lang_name": {
              "name": "Language",
              "available_for_vector_db": true,
              "type": "string"
            },
            "ml_num_words": {
              "name": "Word Count",
              "available_for_vector_db": true,
              "type": "integer"
            },
            "ml_num_chars": {
              "name": "Character Count",
              "available_for_vector_db": true,
              "type": "integer"
            },
            "ml_avg_word_length": {
              "name": "Average Word Length",
              "available_for_vector_db": true,
              "type": "float"
            },
            "ml_num_sentences": {
              "name": "Sentence Count",
              "available_for_vector_db": true,
              "type": "integer"
            },
            "ml_alphanumeric_char_ratio": {
              "name": "Alphanumeric Ratio",
              "available_for_vector_db": true,
              "type": "float"
            },
            "ml_punctuation_char_ratio": {
              "name": "Punctuation Ratio",
              "available_for_vector_db": true,
              "type": "float"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "name": "doc_name",
            "content": "text",
            "embeddings": "vector_embeddings",
            "lang_name": "language",
            "ml_num_words": "word_count",
            "ml_num_chars": "char_count",
            "ml_avg_word_length": "avg_word_len",
            "ml_num_sentences": "sentence_count",
            "ml_alphanumeric_char_ratio": "alpha_ratio",
            "ml_punctuation_char_ratio": "punct_ratio"
          }
        },
        "input_edges": [
          {
            "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"
          }
        ],
        "output_edges": []
      }
    ]
  }
}