{
  "flow_name": "ML Enrichment with OpenSearch Pipeline",
  "description": "Complete pipeline: ingest → extract → language detection → ML enrichment → embeddings → OpenSearch indexing",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "tests/fixtures/customer_support_docs/",
        "include_filter": "txt,pdf",
        "store_binary_content": true,
        "max_workers": 2
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "none"
        }
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "detect_language",
      "type": "lang_detect",
      "config": {
        "doc_column": "content",
        "lang_column": "lang_name"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "ml_enrichment",
      "type": "ml_enrichment",
      "config": {
        "doc_column": "content",
        "lang_column": "lang_name",
        "output_column_prefix": "ml_",
        "error_column_name": "enrichment_error"
      },
      "depends_on": [
        "detect_language"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "litellm",
        "embeddings_model_id": "openai/granite4:latest",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "ml_enrichment"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "ml_enriched_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 2560,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "admin",
          "password": "<MyStrongPass123!>",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "name": {
            "name": "Document Name",
            "available_for_vector_db": true,
            "type": "string"
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          },
          "lang_name": {
            "name": "Language",
            "available_for_vector_db": true,
            "type": "string"
          },
          "ml_num_words": {
            "name": "Word Count",
            "available_for_vector_db": true,
            "type": "integer"
          },
          "ml_num_chars": {
            "name": "Character Count",
            "available_for_vector_db": true,
            "type": "integer"
          },
          "ml_avg_word_length": {
            "name": "Average Word Length",
            "available_for_vector_db": true,
            "type": "float"
          },
          "ml_num_sentences": {
            "name": "Sentence Count",
            "available_for_vector_db": true,
            "type": "integer"
          },
          "ml_alphanumeric_char_ratio": {
            "name": "Alphanumeric Ratio",
            "available_for_vector_db": true,
            "type": "float"
          },
          "ml_punctuation_char_ratio": {
            "name": "Punctuation Ratio",
            "available_for_vector_db": true,
            "type": "float"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "name": "doc_name",
          "content": "text",
          "embeddings": "vector_embeddings",
          "lang_name": "language",
          "ml_num_words": "word_count",
          "ml_num_chars": "char_count",
          "ml_avg_word_length": "avg_word_len",
          "ml_num_sentences": "sentence_count",
          "ml_alphanumeric_char_ratio": "alpha_ratio",
          "ml_punctuation_char_ratio": "punct_ratio"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
