{
  "flow_name": "sample flow",
  "flow_id": "55578a6c-96b0-4f51-af8f-3aa63c575140",
  "description": "a sample flow to demonstrate the datasift pipeline command line execution",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "enable_micro_batching": true,
    "micro_batch_size": 10,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "filesystem",
        "connection_params": {
          "root_path": "./tests/fixtures/customer_support_docs",
          "recursive": true,
          "file_extensions": [
            ".txt",
            ".pdf"
          ],
          "exclude_patterns": [
            "*.tmp",
            "__pycache__/*"
          ],
          "max_file_size_mb": 100,
          "follow_symlinks": false
        }
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": [
        "ingest"
      ],
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        }
      }
    },
    {
      "name": "sql_filter",
      "type": "sql_filter",
      "depends_on": [
        "extract"
      ],
      "config": {
        "criteria_json": {
          "criteria_list": [
            {
              "variable": "path",
              "operator": "is not null"
            }
          ],
          "logical_operator": "AND"
        },
        "features_to_drop": [
          "path"
        ]
      }
    },
    {
      "name": "semantic_chunking",
      "type": "chunker",
      "depends_on": [
        "sql_filter"
      ],
      "config": {
        "chunk_type": "semantic",
        "semantic_embeddings_model": "nomic-embed-text",
        "breakpoint_threshold_type": "percentile",
        "breakpoint_threshold_amount": 95,
        "doc_column": "content",
        "retain_original_content": false
      }
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "depends_on": [
        "semantic_chunking"
      ],
      "config": {
        "provider": "litellm",
        "model_id": "openai/granite4",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}",
          "model_id": "openai/granite4"
        }
      }
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "depends_on": [
        "embeddings"
      ],
      "config": {
        "provider": "opensearch",
        "index_name": "datasift_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 2560,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "${OPENSEARCH_USERNAME}",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "embeddings": "vector_embeddings"
        }
      }
    }
  ]
}