{
  "flow_name": "invoice entities extraction flow",
  "description": "a flow to extract structured invoice entities using Ollama LLM, then chunk and store in OpenSearch",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "src/datasift_opensource/ui/chat_with_docs/uploaded_files/",
        "include_filter": "txt,pdf",
        "store_binary_content": true,
        "max_workers": 2
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4:latest",
            "temperature": 0.0,
            "api_base": "http://localhost:11434/v1",
            "api_key": "<ollama_key>"
          },
          "max_doc_chars": 8000,
          "schema_file": "examples/retrieval/document_schemas.json",
          "schema_table": "invoices_entities"
        }
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "litellm",
        "embeddings_model_id": "openai/granite4:latest",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      }
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "invoices_entities_test",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 2560,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "admin",
          "password": "<MyStrongPass123!>",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          },
          "entities": {
            "name": "Entities",
            "available_for_vector_db": true,
            "type": "object"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "embeddings": "vector_embeddings",
          "entities": "invoice_entities"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}