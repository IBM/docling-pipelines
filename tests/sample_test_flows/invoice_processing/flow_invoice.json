{
  "flow": {
    "name": "invoice processing flow",
    "flow_id": "55578a6c-96b0-4f51-af8f-3aa63c575141",
    "description": "a flow to demonstrate invoice processing with datasift pipeline",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true",
      "force_ingest": true
    },
    "dag": [
      {
        "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
        "name": "ingest",
        "operator": "ingest_local",
        "config": {
          "input_folder": "./tests/fixtures/invoices",
          "include_filter": ".pdf",
          "store_binary_content": "true",
          "max_workers": 2
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ]
      },
      {
        "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
        "name": "extract",
        "operator": "extract_operator",
        "config": {
          "text_extraction_mode": "docling_library",
          "entity_extraction_mode": "docling",
          "doc_column": "content",
          "expand_extracted_data": true,
          "template": {
            "invoice_number": "string",
            "invoice_date": "string",
            "payment_due": "string",
            "bill_to": "string",
            "vendor_name": "string",
            "vendor_address": "string",
            "subtotal": "float",
            "tax": "float",
            "total": "float",
            "grand_total": "float"
          }
        },
        "input_edges": [
          {
            "node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ]
      },
      {
        "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
        "name": "chunk",
        "operator": "chunker",
        "config": {
          "chunk_type": "hybrid",
          "doc_column": "content",
          "chunk_size": 512,
          "chunk_overlap": 128,
          "retain_original_content": "true"
        },
        "input_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ],
        "output_edges": [
          "6de879bd-bbe0-4d60-998f-031f65472a02"
        ]
      },
      {
        "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
        "name": "embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "ollama",
          "embeddings_model_id": "llama2",
          "embeddings_column": "embeddings",
          "overlap_ratio": 0.2,
          "doc_column": "content"
        },
        "input_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ],
        "output_edges": [
          "87249dbf-4a1a-433a-91da-ee5fb3244284"
        ]
      },
      {
        "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
        "name": "vectordb",
        "operator": "vectordb",
        "config": {
          "vector_db_type": "opensearch",
          "index_name": "invoices_test",
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "vector_dimension": 768,
          "create_index": "true",
          "vectordb_parameters": {
            "host": "localhost",
            "port": 9200,
            "username": "admin",
            "password": "MyStrongPass123!",
            "use_ssl": false,
            "verify_certs": false,
            "batch_size": 100,
            "engine": "faiss",
            "algorithm": "hnsw",
            "space_type": "l2"
          },
          "available_features": {
            "doc_id_hash": {
              "name": "Document ID",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "content": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            },
            "extracted_invoice_number": {
              "name": "Invoice Number",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_invoice_date": {
              "name": "Invoice Date",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_vendor_name": {
              "name": "Vendor Name",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_grand_total": {
              "name": "Grand Total",
              "available_for_vector_db": true,
              "type": "float"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "content": "text",
            "embeddings": "vector_embeddings",
            "extracted_invoice_number": "invoice_number",
            "extracted_invoice_date": "invoice_date",
            "extracted_vendor_name": "vendor_name",
            "extracted_grand_total": "grand_total"
          }
        },
        "input_edges": [
          {
            "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"
          }
        ],
        "output_edges": []
      }
    ]
  }
}