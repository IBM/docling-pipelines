{
  "flow_name": "invoice entities extraction flow (expanded) \u2014 UI",
  "description": "UI copy of flow_invoice_entities_expanded: extracts structured invoice entities using Ollama LLM with expand_extracted_data, then chunks and stores in OpenSearch. paths is fixed to the UI uploaded_files directory.",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "src/datasift_opensource/ui/chat_with_docs/uploaded_files/",
        "include_filter": ".pdf",
        "max_workers": 2
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4",
            "api_base": "http://localhost:11434/v1",
            "api_key": "<ollama_key>",
            "temperature": 0.0
          },
          "max_doc_chars": 8000,
          "expand_extracted_data": true,
          "custom_schema": {
            "vendor_name": "string",
            "invoice_date": "string",
            "invoice_number": "string",
            "total_amount": "float",
            "grand_total": "float"
          }
        }
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "hybrid",
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128,
        "retain_original_content": false
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "model_id": "openai/granite4",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "invoices_entities_expanded_test",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 384,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
"username": "${OPENSEARCH_USERNAME}",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          },
          "entities": {
            "name": "Entities",
            "available_for_vector_db": true,
            "type": "string"
          },
          "entity_vendor_name": {
            "name": "Vendor Name",
            "available_for_vector_db": true,
            "type": "string"
          },
          "entity_invoice_date": {
            "name": "Invoice Date",
            "available_for_vector_db": true,
            "type": "string"
          },
          "entity_invoice_number": {
            "name": "Invoice Number",
            "available_for_vector_db": true,
            "type": "string"
          },
          "entity_total_amount": {
            "name": "Total Amount",
            "available_for_vector_db": true,
            "type": "float"
          },
          "entity_grand_total": {
            "name": "Grand Total",
            "available_for_vector_db": true,
            "type": "float"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "embeddings": "vector_embeddings",
          "entities": "invoice_entities",
          "entity_vendor_name": "entity_vendor_name",
          "entity_invoice_date": "entity_invoice_date",
          "entity_invoice_number": "entity_invoice_number",
          "entity_total_amount": "entity_total_amount",
          "entity_grand_total": "entity_grand_total"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}