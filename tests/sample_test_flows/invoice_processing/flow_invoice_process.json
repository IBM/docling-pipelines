{
  "flow_name": "invoice processing flow",
  "description": "a flow to demonstrate invoice processing with datasift pipeline",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "enable_micro_batching": true,
    "micro_batch_size": 10,
    "prefect": {
      "batch_execution": {
        "strategy": "work-pool-process",
        "work_pool_name": "datasift-pool",
        "batch_storage": {
          "type": "local",
          "path": "/tmp/datasift-batches"
        }
      }
    },
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices/",
        "include_filter": ".pdf",
        "store_binary_content": true,
        "max_files": 30,
        "force_ingest": true
      }
    },
    {
      "name": "extract",
      "type": "extract_docling",
      "config": {
        "use_docling_serve": true,
        "doc_column": "content",
        "max_workers": 4,
        "docling_serve_base_url": "http://localhost:30501",
        "docling_serve_ocr_preset": "tesseract",
        "docling_serve_ocr_lang": [
          "eng"
        ],
        "docling_serve_pdf_backend": "dlparse_v2",
        "docling_serve_table_mode": "accurate",
        "docling_serve_image_export_mode": "embedded",
        "docling_serve_timeout": 300,
        "docling_serve_poll_interval": 2
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "simple",
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128,
        "retain_original_content": false
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "litellm",
        "embeddings_model_id": "openai/granite4",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "invoices_test",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 384,
        "create_index": true,
        "batch_size": 100,
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "admin",
          "password": "<MyStrongPass123!>",
          "use_ssl": false,
          "verify_certs": false,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2",
          "available_features": {
            "doc_id_hash": {
              "name": "Document ID",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "content": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            },
            "extracted_invoice_number": {
              "name": "Invoice Number",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_invoice_date": {
              "name": "Invoice Date",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_vendor_name": {
              "name": "Vendor Name",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_grand_total": {
              "name": "Grand Total",
              "available_for_vector_db": true,
              "type": "float"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "content": "text",
            "embeddings": "vector_embeddings",
            "extracted_invoice_number": "invoice_number",
            "extracted_invoice_date": "invoice_date",
            "extracted_vendor_name": "vendor_name",
            "extracted_grand_total": "grand_total"
          }
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
