{
  "flow": {
    "name": "invoice processing flow",
    "flow_id": "55578a6c-96b0-4f51-af8f-3aa63c575141",
    "description": "a flow to demonstrate invoice processing with datasift pipeline",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true",
      "force_ingest": true,
      "enable_micro_batching": true,
      "micro_batch_size": 10,
      "prefect": {
        "batch_execution": {
          "strategy": "work-pool-process",
          "work_pool_name": "datasift-pool",
          "batch_storage": {
            "type": "local",
            "path": "/tmp/datasift-batches"
          }
        }
      }
    },
    "dag": [
      {
        "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
        "name": "ingest",
        "operator": "ingest_local",
        "config": {
          "input_folder": "./tests/fixtures/invoices/",
          "include_filter": ".pdf",
          "store_binary_content": true,
          "max_files": 30,
          "force_ingest": true
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ]
      },
      {
        "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
        "name": "extract",
        "operator": "extract_docling",
        "config": {
          "use_docling_serve": true,
          "doc_column": "content",
          "max_workers": 4,
          "docling_serve_base_url": "http://datasift-worker1.fyre.ibm.com:30501",
          "docling_serve_ocr_preset": "tesseract",
          "docling_serve_ocr_lang": [
            "eng"
          ],
          "docling_serve_pdf_backend": "dlparse_v2",
          "docling_serve_table_mode": "accurate",
          "docling_serve_image_export_mode": "embedded",
          "docling_serve_timeout": 300,
          "docling_serve_poll_interval": 2
        },
        "input_edges": [
          {
            "node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ]
      },
      {
        "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
        "name": "chunk",
        "operator": "chunker",
        "config": {
          "chunk_type": "simple",
          "doc_column": "content",
          "chunk_size": 512,
          "chunk_overlap": 128,
          "retain_original_content": "true"
        },
        "input_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ],
        "output_edges": [
          "6de879bd-bbe0-4d60-998f-031f65472a02"
        ]
      },
      {
        "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
        "name": "embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "ollama",
          "embeddings_model_id": "granite4",
          "embeddings_column": "embeddings",
          "overlap_ratio": 0.2,
          "doc_column": "content"
        },
        "input_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ],
        "output_edges": [
          "87249dbf-4a1a-433a-91da-ee5fb3244284"
        ]
      },
      {
        "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
        "name": "vectordb",
        "operator": "vectordb",
        "config": {
          "provider": "opensearch",
          "index_name": "invoices_test",
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "vector_dimension": 384,
          "create_index": true,
          "batch_size": 100,
          "provider_config": {
            "host": "datasift-worker1.fyre.ibm.com",
            "port": 9200,
            "username": "admin",
            "password": "MyStrongPass123!",
            "use_ssl": false,
            "verify_certs": false,
            "engine": "faiss",
            "algorithm": "hnsw",
            "space_type": "l2",
            "available_features": {
            "doc_id_hash": {
              "name": "Document ID",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "content": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            },
            "extracted_invoice_number": {
              "name": "Invoice Number",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_invoice_date": {
              "name": "Invoice Date",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_vendor_name": {
              "name": "Vendor Name",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_grand_total": {
              "name": "Grand Total",
              "available_for_vector_db": true,
              "type": "float"
            }
          },
            "feature_mappings": {
            "doc_id_hash": "pk",
            "content": "text",
            "embeddings": "vector_embeddings",
            "extracted_invoice_number": "invoice_number",
            "extracted_invoice_date": "invoice_date",
            "extracted_vendor_name": "vendor_name",
            "extracted_grand_total": "grand_total"
          }
          }
        },
        "input_edges": [
          {
            "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"
          }
        ],
        "output_edges": []
      }
    ]
  }
}