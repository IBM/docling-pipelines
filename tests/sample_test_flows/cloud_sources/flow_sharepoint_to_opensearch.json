{
  "flow_name": "SharePoint to OpenSearch Pipeline",
  "description": "Ingest documents from Microsoft SharePoint, chunk text, generate embeddings using Ollama, and store in OpenSearch. The ingest_source operator extracts text via LangChain (no extract_operator needed). Requires Ollama running locally with the specified model.",
  "global_config": {
    "doc_column": "text",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_sharepoint",
      "type": "ingest_source",
      "config": {
        "provider": "sharepoint",
        "connection_params": {
          "document_library_id": "${SHAREPOINT_DOCUMENT_LIBRARY_ID}",
          "recursive": true,
          "credentials": {
            "client_id": "${SHAREPOINT_CLIENT_ID}",
            "client_secret": "${SHAREPOINT_CLIENT_SECRET}",
            "tenant_id": "${SHAREPOINT_TENANT_ID}"
          },
          "include_filter": "pdf,docx,txt,pptx",
          "max_files": 100,
          "force_ingest": true
        }
      }
    },
    {
      "name": "extract_text",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {
            "extract_tables": true,
            "extract_images": true
          }
        },
        "max_workers": 4,
        "entity_extraction": {
          "provider": "none"
        }
      },
      "depends_on": [
        "ingest_sharepoint"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128
      },
      "depends_on": [
        "extract_text"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "litellm",
        "embeddings_model_id": "openai/nomic-embed-text",
        "doc_column": "content",
        "embeddings_column": "embeddings",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "store_opensearch",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "sharepoint_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "create_index": "true",
        "provider_config": {
          "host": "9.30.97.49",
          "port": 9200,
          "username": "admin",
          "password": "<insert_opensearch_password_here>",
          "use_ssl": true,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID Hash",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "source_id": {
            "name": "Source Path",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "source_id": "source_id",
          "embeddings": "vector_embeddings"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
