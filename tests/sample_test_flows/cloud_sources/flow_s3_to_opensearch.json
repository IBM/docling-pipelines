{
  "flow_name": "S3 to OpenSearch Pipeline",
  "description": "Ingest documents from AWS S3 bucket, chunk text, generate embeddings using Ollama, and store in OpenSearch. Requires Ollama running locally with the specified model.",
  "global_config": {
    "doc_column": "text",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_s3",
      "type": "ingest_source",
      "config": {
        "provider": "s3",
        "credentials": {
          "access_key": "enter_access_key",
          "secret_key": "enter_secret_key"
        },
        "connection_params": {
          "bucket": "enter_bucket_name",
          "prefix": ""
        },
        "include_filter": "pdf,docx,txt,pptx",
        "max_files": 15,
        "force_ingest": true
      }
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "doc_column": "text",
        "chunk_size": 512,
        "chunk_overlap": 128
      },
      "depends_on": [
        "ingest_s3"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "ollama",
        "embeddings_model_id": "nomic-embed-text",
        "doc_column": "text",
        "embeddings_column": "embeddings"
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "store_opensearch",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "s3_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "create_index": "true",
        "provider_config": {
          "host": "9.30.97.49",
          "port": 9200,
          "username": "admin",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": true,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID Hash",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "text": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "source_id": {
            "name": "Source Path",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "text": "text",
          "source_id": "source_id",
          "embeddings": "vector_embeddings"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
