{
  "flow": {
    "name": "S3 to OpenSearch Pipeline",
    "flow_id": "s3-flow-001-0000-0000-000000000003",
    "description": "Ingest documents from AWS S3 bucket, chunk text, generate embeddings using Ollama, and store in OpenSearch. Requires Ollama running locally with the specified model.",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "text",
      "disable_validation": "true",
      "force_ingest": true
    },
    "dag": [
      {
        "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
        "name": "ingest_s3",
        "operator": "ingest_source",
        "config": {
          "provider": "s3",
          "credentials": {
            "access_key": "enter_access_key",
            "secret_key": "enter_secret_key"
          },
          "connection_params": {
            "bucket": "enter_bucket_name",
            "prefix": ""
          },
          "include_filter": "pdf,docx,txt,pptx",
          "max_files": 15,
          "force_ingest": true
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          }
        ]
      },
      {
        "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
        "name": "chunk",
        "operator": "chunker",
        "config": {
          "doc_column": "text",
          "chunk_size": 512,
          "chunk_overlap": 128
        },
        "input_edges": [
          {
            "node_id_ref": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "d4e5f6a7-b8c9-0123-defa-234567890123"
          }
        ]
      },
      {
        "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
        "name": "embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "ollama",
          "embeddings_model_id": "nomic-embed-text",
          "doc_column": "text",
          "embeddings_column": "embeddings"
        },
        "input_edges": [
          {
            "node_id_ref": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "e5f6a7b8-c9d0-1234-efab-345678901234"
          }
        ]
      },
      {
        "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
        "name": "store_opensearch",
        "operator": "vectordb",
        "config": {
          "vector_db_type": "opensearch",
          "index_name": "s3_documents",
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "vector_dimension": 768,
          "create_index": "true",
          "vectordb_parameters": {
            "host": "9.30.97.49",
            "port": 9200,
            "username": "admin",
            "password": "${OPENSEARCH_PASSWORD}",
            "use_ssl": true,
            "verify_certs": false,
            "batch_size": 100,
            "engine": "faiss",
            "algorithm": "hnsw",
            "space_type": "l2"
          },
          "available_features": {
            "doc_id_hash": {
              "name": "Document ID Hash",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "text": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "source_id": {
              "name": "Source Path",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "text": "text",
            "source_id": "source_id",
            "embeddings": "vector_embeddings"
          }
        },
        "input_edges": [
          {
            "node_id_ref": "d4e5f6a7-b8c9-0123-defa-234567890123"
          }
        ],
        "output_edges": []
      }
    ]
  }
}