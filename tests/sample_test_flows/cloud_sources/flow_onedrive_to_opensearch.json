{
  "flow_name": "OneDrive to OpenSearch Pipeline",
  "description": "Ingest documents from Microsoft OneDrive, chunk text, generate embeddings using Ollama, and store in OpenSearch. The ingest_source operator extracts text. Requires Ollama running locally with the specified model.",
  "global_config": {
    "doc_column": "text",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_onedrive",
      "type": "ingest_source",
      "config": {
        "provider": "onedrive",
        "connection_params": {
          "drive_id": "${ONEDRIVE_DRIVE_ID}",
          "file_extensions": [".pdf", ".docx", ".txt", ".pptx"],
          "recursive": true,
          "folder_path": "${ONEDRIVE_FOLDER_PATH:}"
        },
        "credentials": {
          "client_id": "${ONEDRIVE_CLIENT_ID}",
          "client_secret": "${ONEDRIVE_CLIENT_SECRET}",
          "tenant_id": "${ONEDRIVE_TENANT_ID}"
        },
        "max_files": 100,
        "force_ingest": true
      }
    },
    {
      "name": "extract_text",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {}
        },
        "max_workers": 4,
        "entity_extraction": {
          "provider": "none"
        }
      },
      "depends_on": [
        "ingest_onedrive"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "depends_on": ["extract_text"],
      "config": {
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128
      }
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "doc_column": "content",
        "embeddings_column": "embeddings",
        "provider_config": {
          "model_id": "openai/nomic-embed-text",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "store_opensearch",
      "type": "vectordb",
      "depends_on": ["embeddings"],
      "config": {
        "provider": "opensearch",
        "index_name": "onedrive_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "create_index": "true",
        "provider_config": {
          "host": "9.30.97.49",
          "port": 9200,
          "username": "${OPENSEARCH_USERNAME}",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": true,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID Hash",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "source_id": {
            "name": "Source Path",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "source_id": "source_id",
          "embeddings": "vector_embeddings"
        }
      }
    }
  ]
}
