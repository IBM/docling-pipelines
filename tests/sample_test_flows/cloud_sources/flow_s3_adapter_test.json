{
    "flow": {
        "name": "S3 Adapter Integration Test",
        "flow_id": "s3-adapter-test-001",
        "description": "Test S3 adapter with hexagonal architecture - ingest documents from AWS S3 bucket using the new adapter pattern",
        "storage": "in-memory",
        "execute_type": "local",
        "global_config": {
            "doc_column": "text",
            "disable_validation": "true",
            "force_ingest": true
        },
        "dag": [
            {
                "id": "s3-ingest-node",
                "name": "ingest_s3_adapter",
                "operator": "ingest_source",
                "config": {
                    "provider": "s3",
                    "credentials": {
                        "access_key": "enter_access_key",
                        "secret_key": "enter_secret_key"
                    },
                    "connection_params": {
                        "bucket": "test-documents-bucket",
                        "prefix": "documents/",
                        "region": "us-east-1",
                        "recursive": true,
                        "skip_hidden_files": true,
                        "skip_empty_files": true,
                        "max_file_size_mb": 100
                    },
                    "include_filter": "pdf,docx,txt",
                    "max_files": 10,
                    "force_ingest": true
                },
                "input_edges": [],
                "output_edges": []
            }
        ]
    }
}