{
  "flow_name": "S3 Adapter Integration Test",
  "description": "Test S3 adapter with hexagonal architecture - ingest documents from AWS S3 bucket using the new adapter pattern",
  "global_config": {
    "doc_column": "text",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_s3_adapter",
      "type": "ingest_source",
      "config": {
        "provider": "s3",
        "credentials": {
          "access_key": "enter_access_key",
          "secret_key": "<enter_secret_key>"
        },
        "connection_params": {
          "bucket": "tm-wkc-storage-1",
          "prefix": "2_small_files/",
          "region": "us-east-1",
          "recursive": true,
          "skip_hidden_files": true,
          "skip_empty_files": true,
          "max_file_size_mb": 100
        },
        "include_filter": "pdf,docx,txt",
        "max_files": 10,
        "force_ingest": true
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "doc_column": "content",
        "text_extraction_provider": "docling_library",
        "entity_extraction_provider": "none"
      },
      "depends_on": [
        "ingest_s3_adapter"
      ]
    }
  ]
}
