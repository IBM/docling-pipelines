{
  "flow_name": "box ingest flow",
  "description": "a sample flow to demonstrate ingesting documents from Box using the ingest_source operator",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "box_driver",
        "connection_params": {
          "recursive": true,
          "max_file_size_mb": 50,
          "exclude_patterns": [
            "*.tmp",
            "Trash/*"
          ]
        },
        "credentials": {
          "credentials_json_path": "${BOX_JWT_CONFIG_FILE}"
        },
        "included_extensions": [
          ".pdf",
          ".docx",
          ".txt",
          ".pptx",
          ".xlsx"
        ],
        "max_files": 10,
        "force_ingest": true,
        "store_binary_content": true
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "doc_column": "${OperatorConstants.Columns.DOC_COLUMN_DEFAULT}",
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none"
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "hybrid",
        "doc_column": "${OperatorConstants.Columns.DOC_COLUMN_DEFAULT}",
        "chunk_size": 512,
        "chunk_overlap": 128,
        "retain_original_content": false
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_type": "ollama",
        "embeddings_model_id": "nomic-embed-text",
        "embeddings_column": "${OperatorConstants.Columns.EMBEDDINGS_COLUMN_DEFAULT}",
        "overlap_ratio": 0.2,
        "doc_column": "${OperatorConstants.Columns.DOC_COLUMN_DEFAULT}"
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "index_name": "datasift_box_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "${OperatorConstants.Columns.EMBEDDINGS_COLUMN_DEFAULT}",
        "vector_dimension": 768,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "admin",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "box_id": {
            "name": "Box File ID",
            "available_for_vector_db": true,
            "type": "string"
          },
          "box_name": {
            "name": "Box File Name",
            "available_for_vector_db": true,
            "type": "string"
          },
          "source_url": {
            "name": "Box URL",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "box_id": "box_file_id",
          "box_name": "box_file_name",
          "source_url": "box_url",
          "embeddings": "vector_embeddings"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
