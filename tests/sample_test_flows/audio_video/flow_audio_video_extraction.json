{
  "flow_name": "audio-video-extraction-pipeline",
  "description": "Audio/Video extraction pipeline using ASR (Automatic Speech Recognition)",
  "global_config": {
    "doc_column": "content",
    "storage": "in-memory",
    "execute_type": "local",
    "disable_validation": false
  },
  "flow": [
    {
      "name": "ingest_audio_video",
      "type": "ingest_local",
      "config": {
        "input_folder": "sample_flows",
        "include_filter": "wav",
        "store_binary_content": true
      }
    },
    {
      "name": "extract_transcription",
      "type": "extract_operator",
      "config": {
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none",
        "use_asr_pipeline": true,
        "asr_model_name": "whisper_turbo",
        "doc_column": "content",
        "extract_tables": false,
        "extract_images": false
      },
      "depends_on": [
        "ingest_audio_video"
      ]
    }
  ]
}
