{
  "flow_name": "audio-video-extraction-pipeline",
  "description": "Audio/Video extraction pipeline using ASR (Automatic Speech Recognition)",
  "global_config": {
    "doc_column": "content",
    "storage": "in-memory",
    "execute_type": "local",
    "disable_validation": false
  },
  "flow": [
    {
      "name": "ingest_audio_video",
      "type": "ingest_local",
      "config": {
        "paths": "sample_flows",
        "include_filter": "wav"
      }
    },
    {
      "name": "extract_transcription",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {
            "extract_tables": false,
            "extract_images": false
          }
        }
      },
      "depends_on": [
        "ingest_audio_video"
      ]
    }
  ]
}
