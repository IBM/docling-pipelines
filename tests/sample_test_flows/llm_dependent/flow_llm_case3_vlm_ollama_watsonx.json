{
  "flow_name": "LLM Dependent Case 3: VLM Ollama + Watsonx Entity",
  "description": "Complete pipeline with docling_library VLM ollama text extraction and watsonx entity extraction, covering classification, PII/HAP, chunking with summarization, and embeddings",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "data_storage_type": "local",
    "data_local_config": {
      "output_folder": "${OUTPUT_FOLDER}/flow_llm_case3_vlm_ollama_watsonx"
    },
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx",
        "store_binary_content": true,
        "max_workers": 2
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "huggingface/meta-llama/Llama-3.3-70B-Instruct",
          "api_key": "${HUGGINGFACE_API_KEY}",
          "request_timeout": 120
        },
        "document_types": {
          "invoice": "Business invoice with line items and totals",
          "receipt": "Payment receipt or transaction confirmation",
          "contract": "Legal contract or agreement",
          "report": "Business or technical report",
          "other": "Other document types"
        },
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {
            "vlm_pipeline": {
              "preset": "fast",
              "engine": "ollama",
              "engine_options": {
                "api_base": "http://localhost:11434",
                "model_id": "llama3.2-vision"
              }
            },
            "extract_tables": true,
            "extract_images": false
          }
        },
        "entity_extraction": {
          "provider": "watsonx",
          "provider_config": {
            "model_id": "ibm/granite-3-8b-instruct",
            "temperature": 0.0,
            "max_tokens": 2000,
            "api_base": "${WATSONX_API_BASE}",
            "api_key": "${WATSONX_API_KEY}",
            "container_kind": "project",
            "container_id": "${WATSONX_CONTAINER_ID}",
            "request_timeout": 120
          },
          "output_column": "entities",
          "expand_extracted_data": false,
          "custom_schema": {
            "invoice_number": "string",
            "invoice_date": "string",
            "total_amount": "float",
            "vendor_name": "string",
            "customer_name": "string"
          }
        },
        "max_workers": 1
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "pii_and_hap",
      "type": "pii_and_hap",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/llama3.2",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        },
        "pii_threshold": 0.5,
        "hap_threshold": 0.75,
        "expected_redactions": [
          "pii",
          "hap"
        ],
        "pii_list": [
          "EmailAddress",
          "PhoneNumber",
          "SocialSecurityNumber",
          "CreditCardNumber",
          "BankAccountNumber",
          "IPAddress"
        ],
        "redaction": true,
        "redaction_character": "*",
        "hap_redaction": true,
        "hap_redaction_character": "#",
        "display_pii": true,
        "batch_size": 4,
        "doc_column": "content"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "simple",
        "chunk_size": 512,
        "chunk_overlap": 50,
        "retain_original_content": false,
        "summarization": {
          "enabled": true,
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4:latest",
            "api_base": "http://localhost:11434/v1",
            "api_key": "${OLLAMA_API_KEY}"
          },
          "summary_sentences": 3,
          "summary_max_words": 50
        }
      },
      "depends_on": [
        "pii_and_hap"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "provider": "watsonx",
        "provider_config": {
          "model_id": "ibm/slate-125m-english-rtrvr-v2",
          "api_key": "${WATSONX_API_KEY}",
          "api_base": "${WATSONX_API_BASE}",
          "container_kind": "project",
          "container_id": "${WATSONX_CONTAINER_ID}",
          "batch_size": 800
        },
        "doc_column": "content",
        "embeddings_column": "embeddings"
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "document_set",
      "type": "document_set",
      "config": {
        "document_set_name": "llm_case3_vlm_ollama_watsonx",
        "description": "Document set for LLM case 3 with VLM ollama and watsonx entity extraction",
        "database_path": "${DUCKDB_PATH}",
        "data_backend": "duckdb",
        "metadata_backend": "duckdb",
        "retain_deleted_docs": false,
        "metadata": {
          "pipeline_version": "1.0",
          "extraction_method": "docling_library_vlm_ollama",
          "entity_extraction": "watsonx",
          "flow_case": "llm_case3"
        }
      },
      "depends_on": [
        "embed"
      ]
    }
  ]
}
