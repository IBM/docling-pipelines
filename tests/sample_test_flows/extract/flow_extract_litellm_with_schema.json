{
  "flow_name": "LiteLLM Entity Extraction with Custom Schema",
  "description": "Entity extraction using LiteLLM with a predefined custom schema for structured data extraction",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx",
        "store_binary_content": true
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4:latest",
            "temperature": 0.0,
            "max_tokens": 2000,
            "api_base": "http://localhost:11434/v1",
            "api_key": "<ollama_key>"
          },
          "max_doc_chars": 8000,
          "custom_schema": {
            "invoice_number": "string",
            "invoice_date": "string",
            "vendor_name": "string",
            "vendor_address": "string",
            "total_amount": "number",
            "currency": "string",
            "line_items": [
              {
                "description": "string",
                "quantity": "number",
                "unit_price": "number",
                "total": "number"
              }
            ]
          },
          "expand_extracted_data": true
        },
        "max_workers": 2
      },
      "depends_on": [
        "ingest"
      ]
    }
  ]
}
