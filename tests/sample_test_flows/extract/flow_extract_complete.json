{
  "flow_name": "Complete Extraction Pipeline Flow",
  "description": "Complete extraction pipeline with text, entities, chunking, and embeddings",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx"
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "ollama",
        "provider_config": {},
        "model_id": "granite4:latest",
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000,
        "extract_tables": true,
        "extract_images": true
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "ollama",
        "doc_column": "content",
        "extract_tables": false,
        "extract_images": false,
        "additional_formats": ["html", "json"],
        "entity_model_name": "granite4:latest",
        "entity_temperature": 0.0,
        "entity_max_tokens": 4096,
        "max_doc_chars": 8000,
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_size": 512,
        "chunk_overlap": 50,
        "chunking_strategy": "simple"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "embeddings_type": "ollama",
        "embeddings_model_id": "nomic-embed-text",
        "embeddings_column": "embeddings",
        "provider_config": {
          "host": "http://localhost:11434",
          "max_concurrent_requests": 10
        }
      },
      "depends_on": [
        "chunk"
      ]
    }
  ]
}
