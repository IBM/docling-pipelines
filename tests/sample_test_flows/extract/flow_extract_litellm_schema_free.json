{
  "flow_name": "LiteLLM Schema-Free Entity Extraction",
  "description": "Entity extraction using LiteLLM without predefined schema - auto-discovers entities from documents",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx,txt",
        "store_binary_content": true
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "<ollama_key>"
        },
        "model_id": "openai/granite4:latest",
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": false,
        "max_content_length": 8000
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "litellm",
        "doc_column": "content",
        "entity_model_name": "openai/granite4:latest",
        "entity_provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "<ollama_key>"
        },
        "entity_temperature": 0.0,
        "entity_max_tokens": 2000,
        "max_doc_chars": 8000,
        "expand_extracted_data": false,
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    }
  ]
}