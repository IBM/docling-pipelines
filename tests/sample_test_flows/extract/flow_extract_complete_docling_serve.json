{
  "flow_name": "Complete Extraction Pipeline Flow with Docling Serve",
  "description": "Complete extraction pipeline using Docling Serve for text extraction, with entities, chunking, and embeddings",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "input_folder": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx,md"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction_mode": "docling_serve",
        "entity_extraction_mode": "ollama",
        "doc_column": "content",
        "docling_serve_base_url": "http://localhost:5001",
        "docling_serve_timeout": 3000,
        "docling_serve_poll_interval": 2,
        "docling_serve_max_retries": 3,
        "docling_serve_verify_ssl": false,
        "docling_serve_do_ocr": true,
        "docling_serve_pdf_backend": "dlparse_v2",
        "entity_model_name": "granite4:latest",
        "entity_temperature": 0.0,
        "entity_max_tokens": 4096,
        "max_doc_chars": 8000,

        "max_workers": 2
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_size": 512,
        "chunk_overlap": 50,
        "chunking_strategy": "simple"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "embeddings_type": "ollama",
        "embeddings_model_id": "nomic-embed-text",
        "embeddings_column": "embeddings",
        "provider_config": {
          "host": "http://localhost:11434",
          "max_concurrent_requests": 10
        }
      },
      "depends_on": [
        "chunk"
      ]
    }
  ]
}