{
  "flow_name": "Complete Extraction Pipeline Flow with Docling Serve",
  "description": "Complete extraction pipeline using Docling Serve for text extraction, with entities, chunking, and embeddings",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx,md"
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/granite4:latest",
          "api_key": "${OLLAMA_API_KEY}",
          "api_base": "http://localhost:11434/v1",
          "temperature": 0.0,
          "max_tokens": 1000
        },
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_serve",
          "provider_config": {
            "base_url": "http://localhost:5001",
            "timeout": 3000,
            "poll_interval": 2,
            "max_retries": 3,
            "verify_ssl": false,
            "do_ocr": true,
            "pdf_backend": "dlparse_v2"
          },
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4:latest",
            "temperature": 0.0,
            "max_tokens": 2000,
            "api_base": "http://localhost:11434/v1",
            "api_key": "<ollama_key>"
          },
          "max_doc_chars": 8000
        },
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_size": 512,
        "chunk_overlap": 50,
        "chunking_strategy": "simple"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "embeddings_column": "embeddings",
        "doc_column": "content",
        "provider_config": {
          "model_id": "openai/nomic-embed-text",
          "api_base": "http://localhost:11434/v1",
          "api_key": "<ollama>"
        }
      },
      "depends_on": [
        "chunk"
      ]
    }
  ]
}
