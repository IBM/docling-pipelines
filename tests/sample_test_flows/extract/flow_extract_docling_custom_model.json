{
  "flow_name": "Docling Entity Extraction with Custom Model",
  "description": "Extraction pipeline using Docling entity extraction with inline HuggingFace model configuration",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "../../../tests/fixtures/invoices",
        "include_filter": "pdf,docx"
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/granite4:latest",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        },
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000,
        "extract_tables": true,
        "extract_images": true
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {
            "extract_tables": true,
            "extract_images": true
          }
        },
        "entity_extraction": {
          "provider": "docling",
          "max_doc_chars": 8000,
          "provider_config": {
            "entity_config": {
              "model_type": "inline",
              "inline_model": {
                "repo_id": "numind/NuExtract-2.0-2B",
                "inference_framework": "transformers",
                "scale": 2.0,
                "temperature": 0.0,
                "max_new_tokens": 4096,
                "load_in_8bit": true,
                "torch_dtype": "bfloat16"
              }
            }
          }
        },
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_size": 512,
        "chunk_overlap": 50,
        "chunking_strategy": "simple"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}",
          "model_id": "openai/nomic-embed-text"
        }
      },
      "depends_on": [
        "chunk"
      ]
    }
  ]
}
