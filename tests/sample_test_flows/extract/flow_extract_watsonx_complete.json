{
  "flow_name": "WatsonX Complete Extraction Pipeline Flow",
  "description": "Complete extraction pipeline using WatsonX for classification and entity extraction",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf,docx",
        "store_binary_content": true
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "watsonx",
        "provider_config": {
          "api_base": "https://wxai-qa.ml.cloud.ibm.com",
          "container_kind": "project",
          "request_timeout": 120
        },
        "model_id": "ibm/granite-3-8b-instruct",
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000,
        "extract_tables": true,
        "extract_images": true
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "watsonx",
        "doc_column": "content",
        "extract_tables": false,
        "extract_images": false,
        "entity_model_name": "ibm/granite-3-8b-instruct",
        "entity_provider_config": {
          "api_base": "https://wxai-qa.ml.cloud.ibm.com",
          "container_kind": "project",
          "request_timeout": 120
        },
        "entity_temperature": 0.0,
        "entity_max_tokens": 4096,
        "max_doc_chars": 8000,
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_size": 512,
        "chunk_overlap": 50,
        "chunking_strategy": "simple"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embed",
      "type": "embeddings",
      "config": {
        "model_name": "nomic-embed-text",
        "embedding_provider": "ollama",
        "ollama_base_url": "http://localhost:11434"
      },
      "depends_on": [
        "chunk"
      ]
    }
  ]
}