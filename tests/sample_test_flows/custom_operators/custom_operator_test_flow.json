{
  "flow_name": "Custom Operator Test Flow",
  "description": "Test flow to demonstrate custom operator loading and execution with extraction",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/customer_support_docs"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": [
        "ingest"
      ],
      "config": {
        "text_extraction": {
          "doc_column": "content",
          "provider": "docling_library"
        }
      }
    },
    {
      "name": "uppercase_transform",
      "type": "uppercase",
      "depends_on": [
        "extract"
      ],
      "config": {
        "doc_column": "content"
      }
    }
  ]
}