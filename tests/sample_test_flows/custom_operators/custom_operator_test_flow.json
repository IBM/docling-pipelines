{
  "name": "Custom Operator Test Flow",
  "flow_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "description": "Test flow to demonstrate custom operator loading and execution with extraction",
  "storage": "in-memory",
  "execute_type": "local",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true
  },
  "dag": [
    {
      "id": "11111111-2222-3333-4444-555555555555",
      "name": "ingest",
      "operator": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/customer_support_docs",
        "store_binary_content": true
      },
      "input_edges": [],
      "output_edges": [{"node_id_ref": "22222222-3333-4444-5555-666666666666"}]
    },
    {
      "id": "22222222-3333-4444-5555-666666666666",
      "name": "extract",
      "operator": "extract_operator",
      "config": {
        "doc_column": "content",
        "text_extraction_provider": "docling_library"
      },
      "input_edges": [{"node_id_ref": "11111111-2222-3333-4444-555555555555"}],
      "output_edges": [{"node_id_ref": "66666666-7777-8888-9999-000000000000"}]
    },
    {
      "id": "66666666-7777-8888-9999-000000000000",
      "name": "uppercase_transform",
      "operator": "uppercase",
      "config": {
        "doc_column": "content"
      },
      "input_edges": [{"node_id_ref": "22222222-3333-4444-5555-666666666666"}],
      "output_edges": []
    }
  ]
}