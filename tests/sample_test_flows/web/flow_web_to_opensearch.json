{
  "flow_name": "Web Crawler to OpenSearch Pipeline",
  "description": "Crawl web pages, extract content using Docling, chunk text, generate embeddings using Ollama, and store in OpenSearch. The ingest_source operator with web adapter crawls specified URLs. Requires Ollama running locally with the specified model.",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_web",
      "type": "ingest_source",
      "config": {
        "provider": "web",
        "connection_params": {
          "urls": [
            "https://example.com",
            "https://www.iana.org/domains/reserved"
          ],
          "max_depth": 1,
          "prevent_outside": true,
          "exclude_patterns": [],
          "timeout": 30
        },
        "max_files": 100,
        "force_ingest": true,
        "store_binary_content": true
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content",
          "provider_config": {
            "extract_tables": true,
            "extract_images": false
          }
        },
        "max_workers": 4
      },
      "depends_on": [
        "ingest_web"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "hybrid",
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128,
        "retain_original_content": false
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}",
          "model_id": "openai/nomic-embed-text"
        },
        "provider": "litellm"
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "vector_db_type": "opensearch",
        "index_name": "datasift_web_documents",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "create_index": "true",
        "provider_config": {
          "host": "localhost",
          "port": 9200,
          "username": "admin",
          "password": "<admin>",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID Hash",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "source_id": {
            "name": "Source URL",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "content": "text",
          "source_id": "source_url",
          "embeddings": "vector_embeddings"
        }
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
