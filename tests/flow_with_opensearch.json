{
  "flow": {
    "name": "OpenSearch Integration Flow with Chunking and Embeddings",
    "flow_id": "opensearch-test-flow-001",
    "description": "A complete test flow demonstrating OpenSearch operator integration with ingest, chunking, and embeddings",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true"
    },
    "dag": [
      {
        "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
        "name": "ingest_documents",
        "operator": "ingest_local",
        "config": {
          "input_folder": "tests/fixtures/customer_support_docs",
          "include_filter": "txt"
        },
        "input_edges": [],
        "output_edges": [
          { "node_id_ref": "5df177f6-92bc-4465-826e-f4df107ffb71" }
        ]
      },
      {
        "id": "5df177f6-92bc-4465-826e-f4df107ffb71",
        "name": "generate_doc_id",
        "operator": "doc_id_hash",
        "config": {
          "doc_column": "content",
          "doc_id_column": "id"
        },
        "input_edges": [
          { "node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd" }
        ],
        "output_edges": [
          { "node_id_ref": "e9c41958-2d27-4c02-ab03-789e031b9500" }
        ]
      },
      {
        "id": "e9c41958-2d27-4c02-ab03-789e031b9500",
        "name": "chunk_documents",
        "operator": "chunker",
        "config": {
          "doc_column": "content",
          "chunk_size": 200,
          "chunk_overlap": 50
        },
        "input_edges": [
          { "node_id_ref": "5df177f6-92bc-4465-826e-f4df107ffb71" }
        ],
        "output_edges": [
          { "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02" }
        ]
      },
      {
        "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
        "name": "generate_embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "local",
          "doc_column": "content",
          "embeddings_column": "embeddings"
        },
        "input_edges": [
          { "node_id_ref": "e9c41958-2d27-4c02-ab03-789e031b9500" }
        ],
        "output_edges": [
          { "node_id_ref": "87249dbf-4a1a-433a-91da-ee5fb3244284" }
        ]
      },
      {
        "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
        "name": "store_in_opensearch",
        "operator": "opensearch",
        "config": {
          "opensearch_host": "localhost",
          "opensearch_port": 9200,
          "opensearch_username": "admin",
          "opensearch_password": "MyStrongPass123!",
          "opensearch_use_ssl": false,
          "opensearch_verify_certs": false,
          "index_name": "datasift_test_index",
          "vector_dimension": 384,
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2",
          "ef_construction": 512,
          "m": 16,
          "ef_search": 512,
          "number_of_shards": 1,
          "number_of_replicas": 0,
          "available_features": {
            "id": {
              "name": "ID",
              "description": "The ID of the document",
              "available_for_filter": true,
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string"
            },
            "name": {
              "name": "Document Name",
              "description": "The name of the document",
              "available_for_vector_db": true,
              "type": "string"
            },
            "content": {
              "name": "Document Content",
              "description": "The content of the document",
              "available_for_filter": true,
              "available_for_vector_db": true,
              "type": "string"
            },
            "doc_id_hash": {
              "name": "Hash ID",
              "description": "Hash ID of the row",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "chunk_sequence_number": {
              "name": "Chunk Sequence number",
              "description": "Sequential chunk number for each text chunk",
              "available_for_vector_db": true,
              "type": "int64"
            },
            "start_index": {
              "name": "Start Index",
              "description": "Chunk starting token position in the source document",
              "available_for_vector_db": true,
              "type": "int64"
            },
            "chunked_content": {
              "name": "Chunked Content",
              "description": "Content containing segmented portions of larger text data",
              "is_internal_feature": true
            },
            "embeddings": {
              "name": "Embeddings",
              "description": "The text embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "id": "document_id",
            "name": "document_name",
            "content": "text",
            "embeddings": "vector_embeddings",
            "chunk_sequence_number": "chunk_seq",
            "start_index": "chunk_start"
          }
        },
        "input_edges": [
          { "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02" }
        ],
        "output_edges": []
      }
    ]
  }
}
