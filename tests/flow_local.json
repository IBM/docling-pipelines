{
    "flow": {
        "name": "sample flow",
        "flow_id": "55578a6c-96b0-4f51-af8f-3aa63c575140",
        "description": "a sample flow to demonstrate the datasift pipeline command line execution",
        "storage": "in-memory",
        "execute_type": "local",
        "global_config": {
            "doc_column": "content",
            "disable_validation": "true"
        },
        "dag": [
            {
                "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
                "name": "ingest",
                "operator": "ingest_local",
                "config": {
                    "input_folder": "cliapp/test/input_docs/customer_support_docs",
                    "include_filter": "pdf, txt" 
                },
                "output_edges": [{"node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"}]
            },
            {
                "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
                "name": "doc_quality",
                "operator": "doc_quality",
                "config": {
                    "doc_column": "content"
                },
                "output_edges": [{"node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"}]
            },
            {
                "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
                "name": "ssn",
                "operator": "redaction",
                "config": {
                    "target_column": "content",
                    "stats_column": "redaction_stats",
                    "redaction_masking_pattern": "*",
                    "redaction_regex": "(?!000|.+0{4})(?:\\d{9}|\\d{3}-\\d{2}-\\d{4})"
                },
                "output_edges": [{"node_id_ref": "5df177f6-92bc-4465-826e-f4df107ffb71"}]
            },
            {
                "id": "5df177f6-92bc-4465-826e-f4df107ffb71",
                "name": "doc_id",
                "operator": "doc_id_hash",
                "config": {
                    "doc_column": "content",
                    "doc_id_column": "id"
                },
                "output_edges": ["e9c41958-2d27-4c02-ab03-789e031b9500"]
            },

            {
                "id": "e9c41958-2d27-4c02-ab03-789e031b9500",
                "name": "chunk",
                "operator": "chunker",
                "config": {
                    "doc_column": "content",
                    "chunk_size": 200,
                    "data_flight_config": { "url": "grpc+tcp://localhost:5005", "output_folder": "sample_flow" },
                    "data_storage_type": "flight" },
                "output_edges": ["6de879bd-bbe0-4d60-998f-031f65472a02"]
            },

            {
                "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
                "name": "embeddings",
                "operator": "embeddings",
                "config": {
                    "embeddings_type": "local",
                    "doc_column": "content",
                    "embeddings_column": "embeddings"
                },
                "output_edges": ["87249dbf-4a1a-433a-91da-ee5fb3244284"]
            },
            {
                "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
                "name": "milvusdb_local",
                "operator": "milvusdb_local",
                "config": {
                    "milvus_db_host": "9.30.97.49",
                    "milvus_db_port": "19530",
                    "doc_id_column": "doc_id",
                    "embeddings_column": "embeddings",
                    "collection_name": "datasift2",
                    "available_features": {
                        "id": {
                            "name": "ID",
                            "description": "The ID of the document",
                            "available_for_filter": true,
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "string"
                        },
                        "name": {
                            "name": "Document Name",
                            "description": "The name of the document",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "size": {
                            "name": "Size",
                            "description": "The size of the document",
                            "available_for_filter": true,
                            "available_for_vector_db": true,
                            "type": "int64"
                        },
                        "created_time": {
                            "name": "Created Time",
                            "description": "When the document was created in the project",
                            "available_for_filter": true,
                            "available_for_vector_db": true,
                            "type": "int64"
                        },
                        "modified_time": {
                            "name": "Modified Time",
                            "description": "When the document was last modified",
                            "available_for_filter": true,
                            "available_for_vector_db": true,
                            "type": "int64"
                        },
                        "content": {
                            "name": "Document Content",
                            "description": "The content of the document",
                            "available_for_filter": true,
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "doc_id_hash": {
                            "name": "Hash ID",
                            "description": "Hash ID of the row",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "string",
                            "is_primary": true
                        },
                        "redaction_stats": {
                            "name": "Redaction Count",
                            "description": "Number of matches found and redacted from the document",
                            "available_for_filter": true
                        },
                        "chunk_sequence_number": {
                            "name": "Chunk Sequence number",
                            "description": "Sequential chunk number for each text chunk, representing its position within a larger document",
                            "available_for_vector_db": true,
                            "type": "int64"
                        },
                        "start_index": {
                            "name": "Start Index",
                            "description": "Chunk starting token position in the source document",
                            "available_for_vector_db": true,
                            "type": "int64"
                        },
                        "chunked_content": {
                            "name": "Chunked Content",
                            "description": "Content containing segmented portions of larger text data.",
                            "is_internal_feature": true
                        },
                        "embeddings": {
                            "name": "Embeddings",
                            "description": "The text embeddings",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "vector"
                        },
                        "sparse_embeddings": {
                            "name": "Sparse Embeddings",
                            "type": "vector_sparse",
                            "description": "Create sparse vectors in Milvus Database",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": false
                        }
                    },
                    "feature_mappings": {
                        "doc_id_hash": "pk",
                        "id": "document_id",
                        "embeddings": "vector_embeddings",
                        "name": "document_name",
                        "sparse_embeddings": "sparse_embeddings",
                        "content": "text"
                    }
                },
                "output_edges": []
            }
        ]
    }
}
