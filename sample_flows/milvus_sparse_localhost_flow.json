{
  "flow_name": "milvus-sparse-document-pipeline",
  "description": "Document processing pipeline with Milvus sparse vectors (BM25): Ingest -> Extract -> Chunk -> Store in Milvus (no embeddings needed)",
  "global_config": {
    "doc_column": "content",
    "disable_validation": "true",
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "type": "ingest_local",
      "name": "ingest_local_folder",
      "config": {
        "input_folder": "./sample_documents",
        "include_filter": "pdf,txt,docx",
        "store_binary_content": true,
        "max_files": 10,
        "max_workers": 4
      }
    },
    {
      "type": "extract_operator",
      "name": "extract_with_docling",
      "config": {
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none",
        "doc_column": "content"
      },
      "depends_on": [
        "ingest_local_folder"
      ]
    },
    {
      "type": "chunker",
      "name": "simple_chunker",
      "config": {
        "chunk_type": "simple",
        "chunk_size": 512,
        "chunk_overlap": 50,
        "retain_original_content": false
      },
      "depends_on": [
        "extract_with_docling"
      ]
    },
    {
      "type": "embeddings",
      "name": "ollama_embeddings",
      "config": {
        "embeddings_type": "ollama",
        "embeddings_model_id": "nomic-embed-text",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.1
      },
      "depends_on": [
        "simple_chunker"
      ]
    },
    {
      "type": "vectordb",
      "name": "milvus_sparse_vector_store",
      "config": {
        "provider": "milvus",
        "index_name": "sample_documents_sparse",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "add_sparse_vector": true,
        "create_index": true,
        "provider_config": {
          "host": "localhost",
          "port": 19530,
          "auth_type": "standalone",
          "username": "<USERNAME>",
          "password": "<PASSWORD>",
          "database": "default",
          "secure": false,
          "batch_size": 100,
          "index_type": "SPARSE_INVERTED_INDEX",
          "metric_type": "BM25"
        },
        "available_features": {
          "doc_id_hash": {
            "name": "Document ID",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "string",
            "is_primary": true
          },
          "content": {
            "name": "Content",
            "available_for_vector_db": true,
            "type": "string"
          },
          "doc_name": {
            "name": "Document Name",
            "available_for_vector_db": true,
            "type": "string"
          },
          "file_path": {
            "name": "File Path",
            "available_for_vector_db": true,
            "type": "string"
          },
          "embeddings": {
            "name": "Embeddings",
            "available_for_vector_db": true,
            "type": "vector"
          },
          "sparse_embeddings": {
            "name": "Sparse Embeddings",
            "available_for_vector_db": true,
            "mandatory_for_vector_db": true,
            "type": "sparse_vector"
          }
        },
        "feature_mappings": {
          "doc_id_hash": "pk",
          "embeddings": "vector",
          "sparse_embeddings": "sparse_vector",
          "content": "text"
        }
      },
      "depends_on": [
        "ollama_embeddings"
      ]
    }
  ]
}