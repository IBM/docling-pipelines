{
  "flow_name": "refetch-original-s3",
  "description": "Ingest documents from an S3 source bucket, re-fetch the original binaries, and archive them to a separate S3 destination bucket. Skips files already present at the destination.",
  "global_config": {
    "execute_type": "local",
    "force_ingest": true,
    "storage": "in-memory"
  },
  "flow": [
    {
      "type": "ingest_source",
      "name": "ingest",
      "config": {
        "provider": "s3",
        "provider_config": {
          "bucket": "my-source-bucket",
          "prefix": "source/",
          "region": "us-east-1",
          "recursive": true
        },
        "credentials": {
          "access_key": "${S3_ACCESS_KEY}",
          "secret_key": "${S3_SECRET_KEY}"
        }
      }
    },
    {
      "type": "storage_output",
      "name": "storage_output",
      "config": {
        "mode": "refetch_original",
        "destination_config": {
          "provider": "s3",
          "provider_config": {
            "bucket": "my-output-bucket",
            "prefix": "exports/",
            "region": "us-east-1",
            "create_dirs": true
          },
          "credentials": {
            "access_key": "${S3_DEST_ACCESS_KEY}",
            "secret_key": "${S3_DEST_SECRET_KEY}"
          }
        },
        "output_structure": {
          "type": "hierarchical",
          "overwrite_existing": true
        }
      },
      "depends_on": ["ingest"]
    }
  ]
}
