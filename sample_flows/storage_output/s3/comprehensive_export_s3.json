{
  "flow_name": "comprehensive-export-s3",
  "description": "Ingest documents from S3, extract text, then write a complete archive per document to a destination S3 bucket: original binary + extracted markdown + metadata JSON sidecar. Useful for compliance, QA, and data handoff.",
  "global_config": {
    "execute_type": "local",
    "force_ingest": true,
    "storage": "in-memory"
  },
  "flow": [
    {
      "type": "ingest_source",
      "name": "ingest",
      "config": {
        "provider": "s3",
        "connection_params": {
          "bucket": "my-source-bucket",
          "prefix": "source/",
          "region": "us-east-1",
          "recursive": true
        },
        "credentials": {
          "access_key": "${S3_ACCESS_KEY}",
          "secret_key": "${S3_SECRET_KEY}"
        }
      }
    },
    {
      "type": "extract_operator",
      "name": "extract",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        }
      },
      "depends_on": ["ingest"]
    },
    {
      "type": "storage_output",
      "name": "storage_output",
      "config": {
        "mode": "comprehensive_export",
        "destination_config": {
          "provider": "s3",
          "connection_params": {
            "bucket": "my-output-bucket",
            "prefix": "exports/",
            "region": "us-east-1",
            "create_dirs": true
          },
          "credentials": {
            "access_key": "${S3_DEST_ACCESS_KEY}",
            "secret_key": "${S3_DEST_SECRET_KEY}"
          }
        },
        "output_format": {
          "content_format": "md",
          "include_metadata_sidecar": true
        },
        "output_structure": {
          "type": "flat",
          "path_template": "{year}/{month}/{doc_id}/{name}.{ext}",
          "overwrite_existing": true
        }
      },
      "depends_on": ["extract"]
    }
  ]
}
