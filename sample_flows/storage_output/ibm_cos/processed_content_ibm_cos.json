{
  "flow_name": "export-markdown-ibm-cos",
  "description": "Ingest documents from IBM COS, extract text with Docling, and write extracted markdown back to an IBM COS bucket. Credentials are read from environment variables.",
  "global_config": {
    "execute_type": "local",
    "force_ingest": true,
    "storage": "in-memory"
  },
  "flow": [
    {
      "type": "ingest_source",
      "name": "ingest",
      "config": {
        "provider": "filesystem",
        "provider_config": {
          "paths": ["/data/source/documents"],
          "recursive": true
        },
        "include_filter": ["pdf"],
        "credentials": {}
      }
    },
    {
      "type": "extract_operator",
      "name": "extract",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        }
      },
      "depends_on": ["ingest"]
    },
    {
      "type": "storage_output",
      "name": "storage_output",
      "config": {
        "mode": "processed_content",
        "destination_config": {
          "provider": "ibm_cos",
          "provider_config": {
            "bucket": "my-ibm-cos-bucket",
            "prefix": "output/documents/",
            "endpoint_url": "https://s3.<region>.cloud-object-storage.appdomain.cloud",
            "create_dirs": true
          },
          "credentials": {
            "access_key": "${COS_DEST_ACCESS_KEY}",
            "secret_key": "${COS_DEST_SECRET_KEY}"
          }
        },
        "output_format": {
          "content_format": "md"
        },
        "output_structure": {
          "type": "hierarchical"
        }
      },
      "depends_on": ["extract"]
    }
  ]
}
