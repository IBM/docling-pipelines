{
  "flow_name": "refetch-original-ibm-cos",
  "description": "Ingest documents from an IBM COS source bucket, re-fetch the original binaries, and archive them to a separate IBM COS destination bucket. Skips files already present at the destination.",
  "global_config": {
    "execute_type": "local",
    "force_ingest": true,
    "storage": "in-memory"
  },
  "flow": [
    {
      "type": "ingest_source",
      "name": "ingest",
      "config": {
        "provider": "filesystem",
        "provider_config": {
          "paths": ["/data/source/documents"],
          "recursive": true
        },
        "include_filter": ["pdf"],
        "credentials": {}
      }
    },
    {
      "type": "storage_output",
      "name": "storage_output",
      "config": {
        "mode": "refetch_original",
        "destination_config": {
          "provider": "ibm_cos",
          "provider_config": {
            "bucket": "my-ibm-cos-bucket",
            "prefix": "output/documents/",
            "endpoint_url": "https://s3.<region>.cloud-object-storage.appdomain.cloud",
            "create_dirs": true
          },
          "credentials": {
            "access_key": "${COS_DEST_ACCESS_KEY}",
            "secret_key": "${COS_DEST_SECRET_KEY}"
          }
        },
        "output_structure": {
          "type": "flat",
          "path_template": "{year}_{month}_{name}.{ext}",
          "overwrite_existing": false
        }
      },
      "depends_on": ["ingest"]
    }
  ]
}
