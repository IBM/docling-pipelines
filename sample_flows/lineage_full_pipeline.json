{
  "flow_name": "lineage-full-pipeline",
  "global_config": {
    "doc_column": "content",
    "storage": "in-memory",
    "execute_type": "local",
    "force_ingest": true,
    "disable_validation": true
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "filesystem",
        "connection_params": {
          "paths": ["./tests/fixtures/customer_support_docs"]
        },
        "include_filter": "txt"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": ["ingest"],
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "max_workers": 4
      }
    },
    {
      "name": "chunk",
      "type": "chunker",
      "depends_on": ["extract"],
      "config": {
        "chunk_type": "simple",
        "chunk_size": 200,
        "chunk_overlap": 20,
        "retain_original_content": false
      }
    },
    {
      "name": "embed",
      "type": "embeddings",
      "depends_on": ["chunk"],
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/nomic-embed-text",
          "api_base": "http://localhost:11434/v1",
          "api_key": "ollama"
        },
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.1
      }
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "depends_on": ["embed"],
      "config": {
        "provider": "opensearch",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "create_index": true,
        "provider_config": {
          "index_name": "lineage-test-index",
          "host": "localhost",
          "port": 9200,
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 50,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "feature_mappings": [
          { "feature_name": "doc_id_hash", "mapped_column_name": "pk" },
          { "feature_name": "content",     "mapped_column_name": "text" },
          { "feature_name": "name",        "mapped_column_name": "doc_name" },
          { "feature_name": "path",        "mapped_column_name": "file_path" },
          { "feature_name": "embeddings",  "mapped_column_name": "vector_embeddings" },
          { "feature_name": "chunk_id",    "mapped_column_name": "chunk_id" },
          { "feature_name": "chunk_index", "mapped_column_name": "chunk_index" }
        ]
      }
    }
  ]
}
