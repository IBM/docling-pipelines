{
  "flow_name": "merge-operator-column-test",
  "description": "Test MergeOperator with column merge (join) using NOOP operators",
  "global_config": {
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_documents",
      "type": "ingest_local",
      "config": {
        "input_folder": "./tests/fixtures/customer_support_docs",
        "include_filter": "txt",
        "max_workers": 2
      }
    },
    {
      "name": "branch1_noop",
      "type": "noop",
      "depends_on": ["ingest_documents"],
      "config": {}
    },
    {
      "name": "branch2_noop",
      "type": "noop",
      "depends_on": ["ingest_documents"],
      "config": {}
    },
    {
      "name": "merge_branches",
      "type": "merge",
      "depends_on": ["branch1_noop", "branch2_noop"],
      "config": {
        "merge_type": "columns",
        "column_option": "inner_join",
        "input_links": [
          {"link_name": "branch1"},
          {"link_name": "branch2"}
        ]
      }
    }
  ]
}