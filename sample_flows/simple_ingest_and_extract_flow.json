{
  "flow_name": "Simple Ingest and Extract Flow",
  "description": "A simple flow to demonstrate ingesting and extracting documents",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "enable_micro_batching": true,
    "micro_batch_size": 5
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "../../../tests/fixtures/customer_support_docs",
        "include_filter": "pdf, txt",
        "store_binary_content": "false"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": [
        "ingest"
      ],
      "config": {
        "doc_column": "content",
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none",
        "additional_formats": ["html", "json"],
        "extract_tables": true,
        "extract_images": false
      }
    }
  ]
}
