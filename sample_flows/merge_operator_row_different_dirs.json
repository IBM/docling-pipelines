{
  "flow_name": "merge-operator-row-different-dirs",
  "description": "Test row merge with documents from two different directories",
  "global_config": {
    "disable_validation": "true",
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest_invoices",
      "type": "ingest_local",
      "config": {
        "input_folder": "./tests/fixtures/invoices",
        "include_filter": "txt,md",
        "store_binary_content": false,
        "max_workers": 2
      }
    },
    {
      "name": "ingest_purchase_orders",
      "type": "ingest_local",
      "config": {
        "input_folder": "./tests/fixtures/purchase_orders",
        "include_filter": "txt",
        "store_binary_content": false,
        "max_workers": 2
      }
    },
    {
      "name": "merge_documents",
      "type": "merge",
      "depends_on": ["ingest_invoices", "ingest_purchase_orders"],
      "config": {
        "merge_type": "rows",
        "input_links": [
          {"link_name": "invoices"},
          {"link_name": "purchase_orders"}
        ]
      }
    }
  ]
}