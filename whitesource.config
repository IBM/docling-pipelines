# Mend for GitHub Enterprise Configuration
# This assumes a "freeze" with all packages pinned in requirements.txt,
# e.g. as a result of `uv export`

# Scan Settings
scanSettings.configMode=LOCAL

# Python Configuration
python.path=python3.12
python.invokePipAsModule=true
python.resolveDependencies=true
python.resolveHierarchyTree=false