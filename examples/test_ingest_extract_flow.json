{
  "flow_name": "Simple Ingest and Extract Flow",
  "description": "A simple flow demonstrating document ingestion and extraction using Docling",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "input_folder": "./tests/fixtures/invoices",
        "include_filter": "pdf",
        "store_binary_content": false
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": [
        "ingest"
      ],
      "config": {
        "doc_column": "content",
        "text_extraction_mode": "docling_library",
        "entity_extraction_mode": "none"
      }
    }
  ]
}
