{
  "flow_name": "Simple Ingest and Extract Flow",
  "description": "A simple flow demonstrating document ingestion and extraction using Docling",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_local",
      "config": {
        "paths": "./tests/fixtures/invoices",
        "include_filter": "pdf"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "depends_on": [
        "ingest"
      ],
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "none"
        }
      }
    }
  ]
}
