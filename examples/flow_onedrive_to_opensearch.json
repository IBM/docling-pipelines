{
    "flow": {
        "name": "OneDrive to OpenSearch Pipeline",
        "flow_id": "onedrive-flow-001-0000-0000-000000000001",
        "description": "Ingest documents from Microsoft OneDrive, chunk text, generate embeddings using Ollama, and store in OpenSearch. The ingest_source operator extracts text via LangChain (no extract_docling needed). Requires Ollama running locally with the specified model.",
        "storage": "in-memory",
        "execute_type": "local",
        "global_config": {
            "doc_column": "text",
            "disable_validation": "true",
            "force_ingest": true
        },
        "dag": [
            {
                "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
                "name": "ingest_onedrive",
                "operator": "ingest_source",
                "config": {
                    "provider": "onedrive",
                    "connection_params": {
                        "drive_id": "b!TyD7d666v0WjgkmT_7eUx3Bn8_n-vS5Lsy1TB-TPtDgcrs1nyK5BS5Wmzz-VTv1q"
                    },
                    "credentials": {
                        "client_id": "a10321ae-a4a2-45b0-8521-fc31df993a92",
                        "client_secret": "iu98Q~mT7.7RsevxhCf_N0p5SWX.q49OgQH29chw",
                        "tenant_id": "5026bd25-722a-46f0-9a21-245d84612840"
                    },
                    "include_filter": "pdf,docx,txt,pptx",
                    "max_files": 100,
                    "force_ingest": true
                },
                "input_edges": [],
                "output_edges": [{"node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"}]
            },
            {
                "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
                "name": "chunk",
                "operator": "chunker",
                "config": {
                    "doc_column": "text",
                    "chunk_size": 512,
                    "chunk_overlap": 128
                },
                "input_edges": [{"node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"}],
                "output_edges": [{"node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"}]
            },
            {
                "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
                "name": "embeddings",
                "operator": "embeddings",
                "config": {
                    "embeddings_type": "ollama",
                    "embeddings_model_id": "nomic-embed-text",
                    "doc_column": "text",
                    "embeddings_column": "embeddings"
                },
                "input_edges": [{"node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"}],
                "output_edges": [{"node_id_ref": "87249dbf-4a1a-433a-91da-ee5fb3244284"}]
            },
            {
                "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
                "name": "store_opensearch",
                "operator": "opensearch",
                "config": {
                    "opensearch_host": "9.30.97.49",
                    "opensearch_port": 9200,
                    "opensearch_username": "admin",
                    "opensearch_password": "8P@ssw0rd12@",
                    "opensearch_use_ssl": true,
                    "opensearch_verify_certs": false,
                    "index_name": "onedrive_documents",
                    "doc_id_column": "doc_id_hash",
                    "embeddings_column": "embeddings",
                    "vector_dimension": 768,
                    "engine": "faiss",
                    "algorithm": "hnsw",
                    "space_type": "l2",
                    "create_index": "true",
                    "available_features": {
                        "doc_id_hash": {
                            "name": "Document ID Hash",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "string",
                            "is_primary": true
                        },
                        "text": {
                            "name": "Content",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "source_id": {
                            "name": "Source Path",
                            "available_for_vector_db": true,
                            "type": "string"
                        },
                        "embeddings": {
                            "name": "Embeddings",
                            "available_for_vector_db": true,
                            "mandatory_for_vector_db": true,
                            "type": "vector"
                        }
                    },
                    "feature_mappings": {
                        "doc_id_hash": "pk",
                        "text": "text",
                        "source_id": "source_id",
                        "embeddings": "vector_embeddings"
                    }
                },
                "input_edges": [{"node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"}],
                "output_edges": []
            }
        ]
    }
}