# Opensearch Configuration
OPENSEARCH_PASSWORD=

# OneDrive Configuration
ONEDRIVE_CLIENT_ID=your-client-id-here
ONEDRIVE_CLIENT_SECRET=your-client-secret-here
ONEDRIVE_TENANT_ID=your-tenant-id-here
ONEDRIVE_DRIVE_ID=your-drive-id-here-or-leave-empty
ONEDRIVE_FOLDER_PATH=/Documents

# SharePoint Configuration
SHAREPOINT_CLIENT_ID=your-client-id-here
SHAREPOINT_CLIENT_SECRET=your-client-secret-here
SHAREPOINT_TENANT_ID=your-tenant-id-here
SHAREPOINT_DOCUMENT_LIBRARY_ID=your-document-library-id-here
SHAREPOINT_FOLDER_PATH=/Shared Documents

# Box Configuration (JWT authentication)
BOX_JWT_CONFIG_FILE=/path/to/your/box-config.json

# S3 Configuration (AWS S3 or S3-compatible storage)
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here
S3_BUCKET=your-bucket-name-here
S3_PREFIX=documents/
S3_ENDPOINT_URL=  # Optional: for S3-compatible storage (e.g., https://s3.example.com)
S3_REGION=us-east-1  # Optional: AWS region

# Web Adapter Configuration
# Comma-separated list of URLs to crawl
WEB_TEST_URLS=https://example.com,https://www.iana.org/domains/reserved
# Maximum depth for recursive crawling (0 = no recursion, max 10)
WEB_TEST_MAX_DEPTH=1
# Request timeout in seconds (1-300)
WEB_TEST_TIMEOUT=30

# OneDrive LangChain Configuration (OAuth2 with token caching)
# Uses LangChain's OneDriveLoader with automatic token management
O365_CLIENT_ID=your-client-id-here
O365_CLIENT_SECRET=your-client-secret-here
O365_TENANT_ID=common-or-your-tenant-id
# Optional: Custom token storage path (default: ~/.credentials/o365_token.txt)
# O365_TOKEN_PATH=~/.credentials/o365_token.txt

# Google Drive Configuration (Service Account)
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=path/to/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# Google Drive Configuration (Using OAuth Client Credentials)
GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here