{
  "schemas": [
    {
      "table": "purchase_orders",
      "description": "Purchase order documents for procurement tracking",
      "columns": {
        "po_number": "VARCHAR - Purchase order number",
        "order_date": "TIMESTAMP - When order was placed",
        "supplier.name": "VARCHAR - Supplier company name",
        "supplier.id": "VARCHAR - Supplier ID",
        "supplier.contact": "VARCHAR - Supplier contact email",
        "department": "VARCHAR - Department that placed order",
        "total_amount": "DOUBLE - Total order amount in dollars",
        "currency": "VARCHAR - Currency code (USD, EUR, INR, etc.)",
        "status": "VARCHAR - Order status (pending, approved, delivered, cancelled)",
        "delivery_date": "TIMESTAMP - Expected/actual delivery date",
        "approved_by": "VARCHAR - Email of approver",
        "shipping_address.street": "VARCHAR - Delivery street address",
        "shipping_address.city": "VARCHAR - Delivery city",
        "shipping_address.state": "VARCHAR - Delivery state",
        "shipping_address.zip": "VARCHAR - Delivery zip code",
        "shipping_address.country": "VARCHAR - Delivery country",
        "items": "NESTED - Array of order items",
        "items.item_id": "VARCHAR - Item ID",
        "items.description": "VARCHAR - Item description",
        "items.quantity": "INTEGER - Quantity ordered",
        "items.unit_price": "DOUBLE - Price per unit",
        "items.total": "DOUBLE - Total for this item",
        "payment_terms": "TEXT - Payment terms and conditions",
        "notes": "TEXT - Additional notes"
      }
    },
    {
      "table": "invoices",
      "description": "Invoice documents for billing and payment tracking",
      "columns": {
        "invoice_number": "VARCHAR - Unique invoice number",
        "invoice_date": "TIMESTAMP - Date invoice was issued",
        "due_date": "TIMESTAMP - Payment due date",
        "vendor.name": "VARCHAR - Vendor/seller company name",
        "vendor.id": "VARCHAR - Vendor ID",
        "vendor.address.street": "VARCHAR - Vendor street address",
        "vendor.address.city": "VARCHAR - Vendor city",
        "vendor.address.state": "VARCHAR - Vendor state",
        "vendor.address.zip": "VARCHAR - Vendor zip code",
        "vendor.address.country": "VARCHAR - Vendor country",
        "vendor.tax_id": "VARCHAR - Vendor tax identification number",
        "vendor.contact": "VARCHAR - Vendor contact email or phone",
        "customer.name": "VARCHAR - Customer/buyer company name",
        "customer.id": "VARCHAR - Customer ID",
        "customer.address.street": "VARCHAR - Customer street address",
        "customer.address.city": "VARCHAR - Customer city",
        "customer.address.state": "VARCHAR - Customer state",
        "customer.address.zip": "VARCHAR - Customer zip code",
        "customer.address.country": "VARCHAR - Customer country",
        "customer.tax_id": "VARCHAR - Customer tax identification number",
        "customer.contact": "VARCHAR - Customer contact email or phone",
        "line_items": "NESTED - Array of invoice line items",
        "line_items.item_id": "VARCHAR - Item or service ID",
        "line_items.description": "VARCHAR - Item or service description",
        "line_items.quantity": "DOUBLE - Quantity of items or hours",
        "line_items.unit_price": "DOUBLE - Price per unit",
        "line_items.discount": "DOUBLE - Discount amount or percentage",
        "line_items.tax_rate": "DOUBLE - Tax rate percentage",
        "line_items.tax_amount": "DOUBLE - Tax amount",
        "line_items.total": "DOUBLE - Line item total",
        "subtotal": "DOUBLE - Subtotal before tax and discounts",
        "discount_total": "DOUBLE - Total discount amount",
        "tax_total": "DOUBLE - Total tax amount",
        "total_amount": "DOUBLE - Final total amount due",
        "currency": "VARCHAR - Currency code (USD, EUR, INR, etc.)",
        "payment_status": "VARCHAR - Payment status (unpaid, partial, paid, overdue)",
        "payment_method": "VARCHAR - Payment method (wire, check, credit card, etc.)",
        "payment_date": "TIMESTAMP - Date payment was received",
        "payment_reference": "VARCHAR - Payment reference or transaction ID",
        "po_number": "VARCHAR - Related purchase order number",
        "terms": "TEXT - Payment terms and conditions",
        "notes": "TEXT - Additional notes or comments"
      }
    },
    {
      "table": "bank_statements",
      "description": "Bank account statements for financial tracking",
      "columns": {
        "statement_id": "VARCHAR - Unique statement identifier",
        "account_number": "VARCHAR - Bank account number (masked)",
        "account_holder.name": "VARCHAR - Account holder full name",
        "account_holder.address.street": "VARCHAR - Account holder street address",
        "account_holder.address.city": "VARCHAR - Account holder city",
        "account_holder.address.state": "VARCHAR - Account holder state",
        "account_holder.address.zip": "VARCHAR - Account holder zip code",
        "account_holder.address.country": "VARCHAR - Account holder country",
        "bank.name": "VARCHAR - Bank name",
        "bank.branch": "VARCHAR - Bank branch name or code",
        "bank.routing_number": "VARCHAR - Bank routing number",
        "bank.swift_code": "VARCHAR - SWIFT/BIC code for international transfers",
        "account_type": "VARCHAR - Account type (checking, savings, business, etc.)",
        "statement_period.start_date": "TIMESTAMP - Statement period start date",
        "statement_period.end_date": "TIMESTAMP - Statement period end date",
        "opening_balance": "DOUBLE - Balance at start of period",
        "closing_balance": "DOUBLE - Balance at end of period",
        "currency": "VARCHAR - Currency code (USD, EUR, INR, etc.)",
        "transactions": "NESTED - Array of transactions",
        "transactions.transaction_id": "VARCHAR - Unique transaction ID",
        "transactions.date": "TIMESTAMP - Transaction date",
        "transactions.post_date": "TIMESTAMP - Date transaction posted to account",
        "transactions.description": "VARCHAR - Transaction description",
        "transactions.type": "VARCHAR - Transaction type (debit, credit, fee, interest, etc.)",
        "transactions.category": "VARCHAR - Transaction category (transfer, payment, withdrawal, deposit, etc.)",
        "transactions.amount": "DOUBLE - Transaction amount",
        "transactions.balance": "DOUBLE - Account balance after transaction",
        "transactions.reference": "VARCHAR - Transaction reference number",
        "transactions.payee": "VARCHAR - Payee or payer name",
        "transactions.check_number": "VARCHAR - Check number if applicable",
        "total_deposits": "DOUBLE - Total deposits during period",
        "total_withdrawals": "DOUBLE - Total withdrawals during period",
        "total_fees": "DOUBLE - Total fees charged during period",
        "interest_earned": "DOUBLE - Interest earned during period",
        "average_balance": "DOUBLE - Average daily balance",
        "minimum_balance": "DOUBLE - Minimum balance during period",
        "overdraft_count": "INTEGER - Number of overdraft occurrences",
        "notes": "TEXT - Additional notes or alerts"
      }
    },
    {
      "table": "credit_card_statements",
      "description": "Credit card statements for expense tracking and payment management",
      "columns": {
        "statement_id": "VARCHAR - Unique statement identifier",
        "card_number": "VARCHAR - Credit card number (masked, last 4 digits)",
        "cardholder.name": "VARCHAR - Cardholder full name",
        "cardholder.address.street": "VARCHAR - Billing street address",
        "cardholder.address.city": "VARCHAR - Billing city",
        "cardholder.address.state": "VARCHAR - Billing state",
        "cardholder.address.zip": "VARCHAR - Billing zip code",
        "cardholder.address.country": "VARCHAR - Billing country",
        "card_issuer": "VARCHAR - Credit card issuer/bank name",
        "card_type": "VARCHAR - Card type (Visa, Mastercard, Amex, etc.)",
        "card_category": "VARCHAR - Card category (personal, business, corporate, etc.)",
        "statement_period.start_date": "TIMESTAMP - Statement period start date",
        "statement_period.end_date": "TIMESTAMP - Statement period end date",
        "statement_date": "TIMESTAMP - Date statement was generated",
        "payment_due_date": "TIMESTAMP - Payment due date",
        "previous_balance": "DOUBLE - Balance from previous statement",
        "payments_credits": "DOUBLE - Total payments and credits applied",
        "purchases": "DOUBLE - Total purchases during period",
        "cash_advances": "DOUBLE - Total cash advances",
        "fees_charged": "DOUBLE - Total fees charged",
        "interest_charged": "DOUBLE - Total interest charged",
        "new_balance": "DOUBLE - Current balance due",
        "minimum_payment_due": "DOUBLE - Minimum payment amount",
        "credit_limit": "DOUBLE - Total credit limit",
        "available_credit": "DOUBLE - Available credit remaining",
        "currency": "VARCHAR - Currency code (USD, EUR, INR, etc.)",
        "transactions": "NESTED - Array of transactions",
        "transactions.transaction_id": "VARCHAR - Unique transaction ID",
        "transactions.date": "TIMESTAMP - Transaction date",
        "transactions.post_date": "TIMESTAMP - Date transaction posted",
        "transactions.description": "VARCHAR - Merchant or transaction description",
        "transactions.category": "VARCHAR - Transaction category (dining, travel, groceries, etc.)",
        "transactions.type": "VARCHAR - Transaction type (purchase, payment, refund, fee, interest, etc.)",
        "transactions.amount": "DOUBLE - Transaction amount",
        "transactions.foreign_amount": "DOUBLE - Original amount in foreign currency",
        "transactions.foreign_currency": "VARCHAR - Foreign currency code",
        "transactions.exchange_rate": "DOUBLE - Exchange rate applied",
        "transactions.merchant.name": "VARCHAR - Merchant name",
        "transactions.merchant.city": "VARCHAR - Merchant city",
        "transactions.merchant.state": "VARCHAR - Merchant state",
        "transactions.merchant.country": "VARCHAR - Merchant country",
        "transactions.merchant.category_code": "VARCHAR - Merchant category code (MCC)",
        "transactions.reference": "VARCHAR - Transaction reference number",
        "rewards.points_earned": "INTEGER - Rewards points earned this period",
        "rewards.points_redeemed": "INTEGER - Rewards points redeemed this period",
        "rewards.points_balance": "INTEGER - Total rewards points balance",
        "rewards.cashback_earned": "DOUBLE - Cashback earned this period",
        "apr.purchases": "DOUBLE - APR for purchases",
        "apr.cash_advances": "DOUBLE - APR for cash advances",
        "apr.balance_transfers": "DOUBLE - APR for balance transfers",
        "late_fee": "DOUBLE - Late payment fee if applicable",
        "overlimit_fee": "DOUBLE - Over limit fee if applicable",
        "payment_history": "TEXT - Payment history summary",
        "alerts": "TEXT - Important alerts or notices",
        "notes": "TEXT - Additional notes"
      }
    },
    {
      "table": "passports",
      "description": "Passport documents for identity verification and travel",
      "columns": {
        "passport_number": "VARCHAR - Unique passport number",
        "passport_type": "VARCHAR - Passport type (regular, diplomatic, official, emergency, etc.)",
        "issuing_country": "VARCHAR - Country that issued the passport",
        "issuing_authority": "VARCHAR - Government authority that issued passport",
        "issue_date": "TIMESTAMP - Date passport was issued",
        "expiry_date": "TIMESTAMP - Date passport expires",
        "place_of_issue": "VARCHAR - City or location where passport was issued",
        "holder.surname": "VARCHAR - Passport holder surname/family name",
        "holder.given_names": "VARCHAR - Passport holder given names/first names",
        "holder.full_name": "VARCHAR - Complete name as appears on passport",
        "holder.nationality": "VARCHAR - Nationality/citizenship",
        "holder.date_of_birth": "TIMESTAMP - Date of birth",
        "holder.place_of_birth.city": "VARCHAR - City of birth",
        "holder.place_of_birth.state": "VARCHAR - State/province of birth",
        "holder.place_of_birth.country": "VARCHAR - Country of birth",
        "holder.gender": "VARCHAR - Gender (M, F, X, etc.)",
        "holder.height": "VARCHAR - Height (e.g., 175 cm, 5'9\")",
        "holder.eye_color": "VARCHAR - Eye color",
        "holder.photo": "BINARY - Passport photo image data",
        "holder.signature": "BINARY - Holder signature image data",
        "personal_id_number": "VARCHAR - National ID or personal identification number",
        "mrz_line1": "VARCHAR - Machine Readable Zone line 1",
        "mrz_line2": "VARCHAR - Machine Readable Zone line 2",
        "mrz_line3": "VARCHAR - Machine Readable Zone line 3 (if applicable)",
        "document_code": "VARCHAR - Document code from MRZ (e.g., P for passport)",
        "optional_data": "VARCHAR - Optional data from MRZ",
        "endorsements": "TEXT - Special endorsements or restrictions",
        "visas": "NESTED - Array of visa stamps",
        "visas.visa_number": "VARCHAR - Visa number",
        "visas.country": "VARCHAR - Country that issued visa",
        "visas.type": "VARCHAR - Visa type (tourist, business, student, work, etc.)",
        "visas.issue_date": "TIMESTAMP - Visa issue date",
        "visas.expiry_date": "TIMESTAMP - Visa expiry date",
        "visas.entries": "VARCHAR - Number of entries allowed (single, multiple)",
        "visas.duration": "VARCHAR - Duration of stay allowed",
        "visas.purpose": "VARCHAR - Purpose of visit",
        "entry_stamps": "NESTED - Array of entry/exit stamps",
        "entry_stamps.country": "VARCHAR - Country of entry/exit",
        "entry_stamps.port": "VARCHAR - Port of entry/exit",
        "entry_stamps.date": "TIMESTAMP - Date of entry/exit",
        "entry_stamps.type": "VARCHAR - Stamp type (entry, exit)",
        "entry_stamps.officer_id": "VARCHAR - Immigration officer ID",
        "emergency_contact.name": "VARCHAR - Emergency contact name",
        "emergency_contact.relationship": "VARCHAR - Relationship to holder",
        "emergency_contact.phone": "VARCHAR - Emergency contact phone",
        "emergency_contact.address": "VARCHAR - Emergency contact address",
        "biometric_data.fingerprints": "BINARY - Fingerprint data (if applicable)",
        "biometric_data.iris_scan": "BINARY - Iris scan data (if applicable)",
        "chip_data": "BINARY - Electronic chip data (for e-passports)",
        "security_features": "TEXT - Description of security features",
        "status": "VARCHAR - Passport status (active, expired, cancelled, lost, stolen)",
        "previous_passport_number": "VARCHAR - Previous passport number if renewed",
        "notes": "TEXT - Additional notes or observations"
      }
    }
  ]
}
