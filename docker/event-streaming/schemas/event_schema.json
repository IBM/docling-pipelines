{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
