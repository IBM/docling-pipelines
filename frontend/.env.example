# ============================================================
# Single .env file — read by the BFF Node process only.
# No vars are bundled into the browser JS.
# The frontend calls relative /api/* paths; the BFF handles routing.
#
# Vars without VITE_ prefix are NOT bundled by Vite into the browser.
# ============================================================

# Reference values (not read by any code, kept for documentation)
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT=30000
ENABLE_ANALYTICS=false
ENABLE_DEBUG=false
APP_NAME=Datasift
APP_VERSION=1.0.0

# BFF server — these ARE read by the Node process at startup
BACKEND_API_URL=http://localhost:8080
BFF_PORT=3001
